  "autoGuideIntro": "Alles, was Sie brauchen, um SSH-Befehle aus externen Apps, Shortcuts und geplanten Aufgaben auszulösen.",
  "autoGuideSectionWhatIs": "Was ist Automatisierung?",
  "autoGuideSectionMacroDroid": "MacroDroid-Einrichtung",
  "autoGuideSectionTasker": "Tasker-Einrichtung",
  "autoGuideSectionIos": "iOS Shortcuts & Siri",
  "autoGuideSectionUrlScheme": "URL-Schema-Referenz",
  "autoGuideSectionBatch": "Stapelverarbeitung",

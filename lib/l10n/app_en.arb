  "connKeyPassphraseWrong": "The passphrase did not open the private key of \"{label}\". Connect again to enter it once more.",
  "@connKeyPassphraseWrong": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connCertRanOut": "The certificate of the key \"{label}\" ran out on {when}. Have a new one issued, then add it in the key's editor on a phone, or on a computer's Keys page with Import certificate or Generate certificate.",
  "@connCertRanOut": {"description": "Error text while a terminal session connects or runs. {label} is the key label. {when} is a time or date.", "placeholders": {"label": {"type": "String", "example": "deploy key"}, "when": {"type": "String", "example": "4 October 2026, 14:30"}}},
  "connCertNotOnDevice": "The key \"{label}\" signs in with a certificate, and this device has none for it. Add one in the key's editor on a phone, or on a computer's Keys page with Import certificate or Generate certificate; one added on another device comes here with its key once this device syncs. The key was not offered without its certificate.",
  "@connCertNotOnDevice": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connAgentKeyNotOnFile": "The key \"{label}\" is held by an SSH agent, and its public key, which names it to the agent, is missing here or cannot be read. Add the key again under Keys, with Connect via ssh-agent.",
  "@connAgentKeyNotOnFile": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connHostKeyNotAcceptedPlain": "The host's key was not accepted, so the connection was not made. Nothing was sent to the host.",

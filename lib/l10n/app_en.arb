  "sftpOnlyMakeHost": "Make this host SFTP only",
  "@sftpOnlyMakeHost": {"description": "Button: save this host as SFTP only (files, no terminal), so that it opens its files from now on."},
  "sftpOnlyMakeNotAllowed": "This host could not be changed here: it is no longer saved, or its vault does not let you edit it. Its files can still be opened.",
  "@sftpOnlyMakeNotAllowed": {"description": "Said when Make this host SFTP only could not save the host: it is not saved any more, or its vault does not let this account edit it."},
  "sftpOnlyTurnedBack": "A device of yours on an older version of ZestSSH turned this host back into SSH. Update that device, or it will do it again.",
  "@sftpOnlyTurnedBack": {"description": "Said on the screen of a host that gave no terminal, when another device of the same account, on a version from before SFTP-only hosts, turned this host back into an SSH host through sync. The reader should update that device."},
  "authenticatorTitle": "Authenticator app",
  "@authenticatorTitle": {"description": "Account, Security: the row of the authenticator app, one of the account's second steps (two-step sign-in)."},
  "authenticatorOnDesc": "Signing in can take the 6-digit code from your authenticator app.",
  "@authenticatorOnDesc": {"description": "Under the Authenticator app row when it is set up."},
  "authenticatorOffDesc": "A 6-digit code from an app such as Google Authenticator, Microsoft Authenticator, 1Password or Bitwarden, when you sign in.",

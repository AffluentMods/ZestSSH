  "teamAttnHeldBack": "{count, plural, =1{1 item is held back: two vaults hold it and neither copy could move it} other{{count} items are held back: two vaults hold each and neither copy could move it}}",
  "@teamAttnHeldBack": {"description": "Quiet row under Needs attention on the team overview, for owners and admins. An item has live copies in two vaults, and neither copy's author could have moved it out of the other vault, so new devices show neither. {count} is a number; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "heldBackTitle": "Items held back",
  "@heldBackTitle": {"description": "Title of the short list opened from that row."},
  "heldBackBody": "A new device cannot tell which copy is the item, so it shows neither until one is kept or removed. Connecting to hosts is not affected.",

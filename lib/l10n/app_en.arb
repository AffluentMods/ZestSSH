  "twoStepRule": "Use passkeys or an authenticator app. Backup codes work with either.",
  "@twoStepRule": {"description": "The rule of two-step sign-in, under its status: one kind of second step or the other."},
  "passkeyReplaceAuthenticatorTitle": "Replace your authenticator app with a passkey?",
  "@passkeyReplaceAuthenticatorTitle": {"description": "Asked before a passkey replaces the account's authenticator app."},
  "passkeyReplaceAuthenticatorBody": "An account uses passkeys or an authenticator app, not both. Once the passkey is added, codes from your authenticator app stop working. Your backup codes keep working, and your other devices are signed out.",
  "@passkeyReplaceAuthenticatorBody": {"description": "Why a passkey replaces the authenticator app, and what that does."},
  "passkeyReplaceAuthenticatorConfirm": "Replace with a passkey",
  "@passkeyReplaceAuthenticatorConfirm": {"description": "The button that replaces the authenticator app with a passkey."},
  "authenticatorReplacePasskeysTitle": "Replace your passkeys with an authenticator app?",
  "@authenticatorReplacePasskeysTitle": {"description": "Asked before an authenticator app replaces the account's passkeys."},
  "authenticatorReplacePasskeysBody": "An account uses passkeys or an authenticator app, not both. Your passkeys are removed as you finish setting up the app. Your backup codes keep working, and your other devices are signed out. First, sign in again to confirm it's you.",
  "@authenticatorReplacePasskeysBody": {"description": "Why an authenticator app replaces the passkeys, what that does, and that the phone signs in again first."},
  "authenticatorReplacePasskeysConfirm": "Use an authenticator app",
  "@authenticatorReplacePasskeysConfirm": {"description": "The button that replaces the passkeys with an authenticator app."},
  "authenticatorPasskeysFirstTitle": "Remove your passkeys first?",
  "@authenticatorPasskeysFirstTitle": {"description": "Asked where Firebase sets up the authenticator app only once the passkeys are gone."},
  "authenticatorPasskeysFirstBody": "The sign-in service sets up the authenticator app only once your passkeys are gone, so two-step sign-in is off from then until you finish. If you stop before that, it stays off until you set the app up or add a passkey again.",
  "@authenticatorPasskeysFirstBody": {"description": "That two-step sign-in is off from when the passkeys go until the authenticator app is set up."},
  "authenticatorPasskeysFirstConfirm": "Remove my passkeys and go on",
  "@authenticatorPasskeysFirstConfirm": {"description": "The button that removes the passkeys first and goes on with the authenticator app."},
  "authenticatorPasskeysStayNote": "Your passkeys stay until you enter the code: they are removed as the app is turned on.",
  "@authenticatorPasskeysStayNote": {"description": "On the authenticator setup in the place of passkeys, while they are still there."},
  "twoStepGapNote": "Your passkeys are removed. Two-step sign-in is off until you finish here.",
  "@twoStepGapNote": {"description": "On the authenticator setup once the passkeys went: two-step sign-in is off until it is finished."},
  "twoStepGapStop": "Stop, leave it off",
  "@twoStepGapStop": {"description": "The cancel button of the authenticator setup once the passkeys went."},
  "authenticatorReplaceVerify": "Turn on and remove passkeys",
  "@authenticatorReplaceVerify": {"description": "The button that finishes the authenticator setup and removes the passkeys."},
  "twoStepLeftOff": "Your passkeys were removed, and the authenticator app was not set up, so two-step sign-in is off. Set the app up again, or add a passkey.",
  "@twoStepLeftOff": {"description": "The passkeys went for the authenticator app, which was not set up (ZS-1312)."},
  "twoStepAuthenticatorLost": "Your authenticator app was removed, but the passkey could not be added, so two-step sign-in is off. Add the passkey again, or set up an authenticator app.",
  "@twoStepAuthenticatorLost": {"description": "ZestSSH Cloud: authenticator-removed-passkey-failed (ZS-1312)."},
  "twoStepAuthenticatorOnError": "Your account uses an authenticator app. An account uses passkeys or an authenticator app, not both: add the passkey again and choose to replace the app, or keep it.",
  "@twoStepAuthenticatorOnError": {"description": "ZestSSH Cloud: authenticator-app-on, where the app did not know (ZS-1313)."},
  "twoStepNoPasskeys": "Your account has no passkeys any more. The section now shows what it has.",
  "@twoStepNoPasskeys": {"description": "ZestSSH Cloud: no-passkeys (removing passkeys the account no longer has)."},
  "passkeyReplacedAuthenticator": "Passkey added in place of your authenticator app: {name}. Codes from the app no longer work; your backup codes do.",

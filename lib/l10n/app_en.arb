  "lockoutTitle": "Recover your account",
  "@lockoutTitle": {"description": "Title of the account recovery for someone who lost every second step and every backup code (lock-out recovery)."},
  "lockoutIntro": "For when you lost every second step (your passkeys or your authenticator app) and every backup code. ZestSSH emails a code to your address. Once you enter it, the recovery waits seven days, and every device signed in to your account is told, with a way to cancel it. Then two-step sign-in can be turned off.",
  "@lockoutIntro": {"description": "The first step of the account recovery: what it is for and how it goes."},
  "lockoutSendCode": "Send the code",
  "@lockoutSendCode": {"description": "Button: email the recovery code to the address typed."},
  "lockoutCodeSent": "If {email} has an account that can be recovered this way, a code is on its way there. Enter it here. It works for half an hour.",
  "@lockoutCodeSent": {"description": "After asking for a recovery: the same words for every address, so nobody learns whether it has an account. {email} is an email address.", "placeholders": {"email": {"type": "String", "example": "sam@example.com"}}},
  "lockoutResetCodeSent": "To reset the account, show that {email} is still yours: a code is on its way there. Enter it here, and the reset goes on.",
  "@lockoutResetCodeSent": {"description": "Before a recovery resets the account: the recovery's ticket on this device is older than half an hour, so the address must be shown again (code recovery-confirm-again). A code was just emailed.", "placeholders": {"email": {"type": "String", "example": "sam@example.com"}}},
  "lockoutCodeLabel": "Code from the email",
  "@lockoutCodeLabel": {"description": "Label of the field for the 8-digit code emailed for a recovery."},
  "lockoutConfirm": "Start the recovery",
  "@lockoutConfirm": {"description": "Button: confirm the emailed code, which starts the seven days of the recovery."},
  "lockoutAskAgain": "Send a new code",
  "@lockoutAskAgain": {"description": "Link: go back and ask for a new recovery code."},
  "lockoutCodeInvalid": "That code did not work, or it ran out. Check it, or send a new one.",
  "@lockoutCodeInvalid": {"description": "The emailed recovery code was wrong or ran out (code recovery-code-invalid)."},
  "lockoutWaitingSelfTitle": "Your recovery waits",
  "@lockoutWaitingSelfTitle": {"description": "Title while a recovery this device asked for waits for its seven days."},
  "lockoutWaitingSelfBody": "The recovery of {email} waits until {date}. Then you can complete it here. Until then, any device signed in to the account can cancel it, and ZestSSH emails the address again the day before.",
  "@lockoutWaitingSelfBody": {"description": "While a recovery this device asked for waits. {email} is an email address. {date} is a date.", "placeholders": {"email": {"type": "String", "example": "sam@example.com"}, "date": {"type": "String", "example": "6 November 2026"}}},
  "lockoutForget": "Forget this recovery",
  "@lockoutForget": {"description": "Button: this device stops waiting for its recovery (the recovery itself stays on ZestSSH Cloud until it lapses)."},
  "lockoutForgetTitle": "Forget this recovery on this device?",
  "@lockoutForgetTitle": {"description": "Title of the confirmation before forgetting a waiting recovery."},
  "lockoutForgetBody": "This device stops waiting for it. The recovery itself stays until it lapses, unless a device signed in to the account cancels it. You can ask for a new one.",
  "@lockoutForgetBody": {"description": "Body of the confirmation before forgetting a waiting recovery."},
  "lockoutDueTitle": "Complete your recovery",
  "@lockoutDueTitle": {"description": "Title once the recovery's seven days have passed."},
  "lockoutDueBodyProof": "Enter the sync password of {email} to keep your synced data. Then two-step sign-in is turned off, every device is signed out, and you sign in with your password, Google, Apple, Microsoft or your company.",
  "@lockoutDueBodyProof": {"description": "Completing a recovery with the sync password, which keeps the synced data. {email} is an email address.", "placeholders": {"email": {"type": "String", "example": "sam@example.com"}}},

  "@lockedWorkflowsSteps": {"description": "The locked Workflows page: the first of three things workflows give (a workflow's steps: a command, a snippet, a wait, a notification)."},
  "lockedWorkflowsFrom": "Run them from here, from a link, or from apps like Tasker and Shortcuts",
  "@lockedWorkflowsFrom": {"description": "The locked Workflows page: the second of three things workflows give (where a run starts: the app, a zestssh:// link, another app with an API key)."},
  "lockedWorkflowsNotify": "Be told when a run fails",
  "@lockedWorkflowsNotify": {"description": "The locked Workflows page: the third of three things workflows give (a notification when a run fails, on by default)."},
  "lockedScheduledTitle": "Scheduled tasks are part of Squeezed",
  "@lockedScheduledTitle": {"description": "A phone's Scheduled tasks page (Android) for an account without Squeezed: the title of the card over a faded preview of the page. Squeezed is a name, never translated."},
  "lockedScheduledTimer": "Run a command, a snippet or a workflow on a timer",
  "@lockedScheduledTimer": {"description": "The locked Scheduled tasks page: the first of three things scheduled tasks give (what a task runs)."},
  "lockedScheduledBackground": "In the background, with no Tasker or MacroDroid needed",
  "@lockedScheduledBackground": {"description": "The locked Scheduled tasks page: the second of three things scheduled tasks give (they run in the background on Android, with no other app)."},
  "lockedScheduledLastRun": "See when each one last ran and how it went",
  "@lockedScheduledLastRun": {"description": "The locked Scheduled tasks page: the third of three things scheduled tasks give (each task shows its last run and its result)."},
  "hostMenuOrganize": "Organize",
  "@hostMenuOrganize": {"description": "A host's right-click menu on a computer: the submenu (and on a phone, the section of the host's sheet) with where the host is kept: Move to group, Pin, Duplicate, Save as a .zest file, Select."},
  "hostMenuTools": "Tools",
  "@hostMenuTools": {"description": "A host's right-click menu on a computer: the submenu (and on a phone, the section of the host's sheet) with what else may be done with the host: Copy SSH command, tmux, Add a screen, Open an X program, Health."},
  "densityAuto": "Auto",
  "@densityAuto": {"description": "Settings, Appearance, Control size: the choice that follows the input (touch sized while touch is used, smaller while a mouse or trackpad is)."},
  "densityComfortable": "Comfortable",
  "@densityComfortable": {"description": "Settings, Appearance, Control size: touch sized controls (48 high rows, buttons and tabs) whatever the input."},
  "densityCompact": "Compact",
  "@densityCompact": {"description": "Settings, Appearance, Control size: a computer's smaller controls, for a mouse or a trackpad, whatever the input."},
  "settingsControlSize": "Control size",
  "@settingsControlSize": {"description": "Settings, Appearance: the name of the row that picks how big the app's buttons, rows and tabs are (Auto, Comfortable, Compact). Not the host cards' Density."},
  "settingsControlSizeDesc": "How big buttons, rows and tabs are. Auto makes them touch sized while you use touch, and smaller while you use a mouse or trackpad.",
  "@settingsControlSizeDesc": {"description": "Settings, Appearance, Control size: its help, under More."},
  "hpanelAlertsAtButton": "Alerts at {value}",
  "@hpanelAlertsAtButton": {"description": "The host panel's alert control for one metric where the controls are touch sized (a tablet): where the metric alerts, opening its alert menu. As hpanelAlertsAt, at the start of a control. {value} is the limit, e.g. 70%.", "placeholders": {"value": {"type": "String"}}},
  "connectionEditRdpPasswordNote": "The key holds the username and the password; with none, they are asked for when the screen opens. For a domain account, write the username as DOMAIN\\user or user@domain.",
  "@connectionEditRdpPasswordNote": {"description": "Host editor, an RDP host: under the key field. DOMAIN\\user and user@domain are literal examples, not translated."},
  "connectionEditRdpDirectNote": "With no SSH host, the connection goes straight to the server, always inside TLS. Its certificate is asked about the first time and remembered.",
  "@connectionEditRdpDirectNote": {"description": "Host editor, an RDP host reached with no SSH host: a plain note (not a warning) under the reach choice."},
  "connectionEditRdpGateway": "An RD Gateway",
  "@connectionEditRdpGateway": {"description": "The host editor's \"Reach through\" choice for an RDP host reached through a Remote Desktop Gateway (beside the SSH hosts and \"Directly\")."},
  "connectionEditReachDirectNote": "Straight to its address, with no SSH host",
  "@connectionEditReachDirectNote": {"description": "Host editor, Reach through menu (VNC/RDP): the grey second line under 'Directly (TLS required)'."},
  "connectionEditReachGatewayNote": "Through a Remote Desktop Gateway, on port 443",
  "@connectionEditReachGatewayNote": {"description": "Host editor, Reach through menu (RDP): the grey second line under 'An RD Gateway'."},
  "connectionEditReachSshSection": "Through an SSH host",
  "@connectionEditReachSshSection": {"description": "Host editor, Reach through menu: heading above the list of SSH hosts a screen can be reached through."},
  "connectionEditReachSearch": "Search hosts",
  "@connectionEditReachSearch": {"description": "Host editor, Reach through menu: placeholder of the search field shown when there are many SSH hosts."},
  "connectionEditReachNoMatches": "No hosts match",
  "@connectionEditReachNoMatches": {"description": "Host editor, Reach through menu: shown when the search matches no SSH host."},
  "connectionEditRdpGatewayHost": "Gateway address",
  "@connectionEditRdpGatewayHost": {"description": "The host editor's field for the Remote Desktop Gateway's address."},
  "connectionEditRdpGatewayHostInvalid": "Not an address a gateway can have",
  "@connectionEditRdpGatewayHostInvalid": {"description": "Under the gateway's address field when what is typed cannot be an address (a space, a slash, an at sign, a leading dash)."},
  "connectionEditRdpGatewaySignIn": "Gateway sign-in",
  "@connectionEditRdpGatewaySignIn": {"description": "The host editor's choice of how the Remote Desktop Gateway signs in: the PC's own account, or a key."},
  "connectionEditRdpGatewaySameSignIn": "The same as the PC's",
  "@connectionEditRdpGatewaySameSignIn": {"description": "The first choice under the gateway's sign-in: it signs in with the same account as the PC (the host's key)."},
  "connectionEditRdpGatewayNote": "The gateway is told which PC this connects to and carries the connection without reading it (the PC's own TLS is inside). Signing in the same as the PC gives the gateway the PC's account and password; a key of its own keeps them apart. Its certificate is asked about once, apart from the PC's.",
  "@connectionEditRdpGatewayNote": {"description": "The note under a Remote Desktop Gateway's fields: what the gateway learns and is given."},
  "connectionEditRdpWithoutNla": "Sign in without NLA",
  "@connectionEditRdpWithoutNla": {"description": "Host editor, an RDP host: a switch, off by default. NLA is Network Level Authentication."},
  "connectionEditRdpWithoutNlaNote": "Only for a server without Network Level Authentication, such as xrdp. The server then shows its own sign-in screen before it knows who is asking.",
  "@connectionEditRdpWithoutNlaNote": {"description": "Host editor, under the 'Sign in without NLA' switch; shown as a warning while the switch is on. xrdp is a product name."},
  "connectionEditRdpGraphics": "Graphics",
  "@connectionEditRdpGraphics": {"description": "Host editor, an RDP host: the label of the choice of how the server draws the picture."},
  "connectionEditRdpGraphicsAuto": "Auto",
  "@connectionEditRdpGraphicsAuto": {"description": "RDP graphics choice: the app decides."},
  "connectionEditRdpGraphicsModern": "Modern",
  "@connectionEditRdpGraphicsModern": {"description": "RDP graphics choice: the newer graphics pipeline."},
  "connectionEditRdpGraphicsRemoteFx": "RemoteFX",
  "@connectionEditRdpGraphicsRemoteFx": {"description": "RDP graphics choice: RemoteFX, a product name, not translated."},
  "connectionEditRdpGraphicsBasic": "Basic",
  "@connectionEditRdpGraphicsBasic": {"description": "RDP graphics choice: plain bitmaps, for an old or slow server."},
  "screenRdpSignInRefused": "The server did not accept the username and password.",
  "@screenRdpSignInRefused": {"description": "A remote screen (RDP) did not open: the server did not take the account's user name and password (ZS-1812)."},
  "screenRdpNlaMissing": "This server has no Network Level Authentication. For a server like xrdp, turn on \"{setting}\" for this host.",
  "@screenRdpNlaMissing": {"description": "A remote screen (RDP) did not open: the server has no Network Level Authentication and the host asks for it (ZS-1813). {setting} is the host editor's switch, 'Sign in without NLA', in the app's language.", "placeholders": {"setting": {"type": "String"}}},
  "screenRdpNlaRequired": "This server only signs in with Network Level Authentication. Turn off \"{setting}\" for this host.",
  "@screenRdpNlaRequired": {"description": "A remote screen (RDP) did not open: the server signs in with Network Level Authentication only and the host says without (ZS-1814). {setting} is the host editor's switch, 'Sign in without NLA', in the app's language.", "placeholders": {"setting": {"type": "String"}}},
  "screenRdpAccountLocked": "This account is locked on the server. Wait a while, or ask whoever runs the server to unlock it.",
  "@screenRdpAccountLocked": {"description": "A remote screen (RDP) did not open: the server says the account is locked out, usually after wrong passwords (ZS-1815)."},
  "screenRdpAccountDisabled": "This account is turned off on the server.",
  "@screenRdpAccountDisabled": {"description": "A remote screen (RDP) did not open: the server says the account is disabled (ZS-1816)."},
  "screenRdpPasswordExpired": "This account's password has expired. Change it at the PC itself, or ask whoever runs it, then connect again.",
  "@screenRdpPasswordExpired": {"description": "A remote screen (RDP) did not open: the server says the account's password has expired or must be changed before signing in (ZS-1817). The app cannot change it."},
  "screenRdpAccountNotAllowed": "This account may not sign in to this server over Remote Desktop.",
  "@screenRdpAccountNotAllowed": {"description": "A remote screen (RDP) did not open or was ended: the account exists and its password was right, and it may not sign in over Remote Desktop (not in the Remote Desktop Users group, an empty password, outside its hours) (ZS-1818)."},
  "screenRdpTakenOver": "The session was taken over: this account signed in from somewhere else, or at the PC itself.",
  "@screenRdpTakenOver": {"description": "A remote screen (RDP) ended: the same account connected from another device, or signed in at the PC itself, which took the session (ZS-1819). The app does not reconnect by itself, or the two would take it from each other."},
  "screenRdpLicence": "The server's Remote Desktop licensing refused the session. Whoever runs the server has to fix that.",
  "@screenRdpLicence": {"description": "A remote screen (RDP) did not open or ended: the server's Remote Desktop licensing refused it (no licence server, no licence left) (ZS-1820). Only the server's administrator can fix it."},
  "screenRdpServerEnded": "The server ended the session.",
  "@screenRdpServerEnded": {"description": "A remote screen (RDP) ended: the server ended the session and gave no reason the app has words for. Nothing is wrong on this side."},
  "screenRdpEndedIdle": "The server ended the session because it was idle for too long.",
  "@screenRdpEndedIdle": {"description": "A remote screen (RDP) ended: the server's idle time limit ran out."},
  "screenRdpEndedLogonTimeout": "The server ended the session because nobody signed in at its sign-in screen in time.",
  "@screenRdpEndedLogonTimeout": {"description": "A remote screen (RDP) ended: nobody signed in at the server's own sign-in screen within the time it allows (a host set to sign in without NLA)."},
  "screenRdpEndedDenied": "The server refused the connection.",
  "@screenRdpEndedDenied": {"description": "A remote screen (RDP) ended: the server refused the connection and said no more."},
  "screenRdpEndedFreshCredentials": "This server does not accept a saved password: it wants the password typed for each connection.",
  "@screenRdpEndedFreshCredentials": {"description": "A remote screen (RDP) ended: the server is set to take no saved credentials and wants the password typed for every connection."},
  "screenRdpEndedByAdmin": "Someone who manages the server ended this session.",
  "@screenRdpEndedByAdmin": {"description": "A remote screen (RDP) ended: someone with administrator's tools on the server disconnected the session or signed it out."},
  "screenRdpEndedSignedOut": "The remote session was signed out.",
  "@screenRdpEndedSignedOut": {"description": "A remote screen (RDP) ended: the account was signed out inside the remote session (Sign out in its Start menu). Nothing is wrong."},
  "screenRdpEndedDisconnected": "The remote session was disconnected from inside it. It is still running on the server.",
  "@screenRdpEndedDisconnected": {"description": "A remote screen (RDP) ended: Disconnect was chosen inside the remote session. The session keeps running on the server and can be connected to again."},
  "screenRdpEndedShutdown": "The server is shutting down or restarting.",
  "@screenRdpEndedShutdown": {"description": "A remote screen (RDP) ended: the server is shutting down or restarting."},
  "screenClipboardRemoteTooLarge": "The remote clipboard holds more than 1 MB of text, so it was not copied here",
  "@screenClipboardRemoteTooLarge": {"description": "Shown briefly in a remote screen's view: text was copied on the remote computer, the clipboard is shared, and the text is more than 1 MB, so it was not brought to this device's clipboard."},
  "screenTagTooltipRdp": "A remote screen (RDP)",
  "@screenTagTooltipRdp": {"description": "Tooltip of the small RDP tag on a remote screen's tab and header (4.0)."},
  "automationBlockedScreen": "This host is a remote screen. A screen is for someone to look at, and nobody was there, so it was not opened. Open it yourself in ZestSSH.",
  "@automationBlockedScreen": {"description": "Notice shown when another app or a scheduled task asked ZestSSH to open a session to a saved host with nobody there, and the host is a remote screen (VNC or RDP). A screen is a picture for a person to look at, and its questions (trust a certificate, type a password) need a person, so it is not opened unattended."},
  "screenResizeUnavailable": "This server cannot change the size of its screen, so the picture is fitted to the tab instead",
  "@screenResizeUnavailable": {"description": "Shown briefly in a remote screen's tab (RDP) set to 'Resize the remote': this server cannot change the size of its screen (an old xrdp, for one), so the picture is shown fitted to the tab instead."},
  "screenRdpPasswordWhy": "Type this account's password. The host signs in before the server shows anything (Network Level Authentication).",
  "@screenRdpPasswordWhy": {"description": "Password dialog, an RDP host whose key has no saved password: why the password is asked for before anything is shown. Network Level Authentication (NLA) is RDP's sign-in that happens before the server shows its screen."},
  "screenRdpPasswordAgain": "The server did not accept the username and password. Type the password again.",
  "@screenRdpPasswordAgain": {"description": "Password dialog, an RDP host: the server refused the user name and password; the password is asked for again."},
  "screenRdpAccountWhy": "This host has no key to sign in with. Type the account's username and password.",
  "@screenRdpAccountWhy": {"description": "Password dialog, an RDP host that has no key: both the user name and the password of the account are asked for."},
  "screenRdpAccountAgain": "The server did not accept the username and password. Check both and type them again.",
  "@screenRdpAccountAgain": {"description": "Password dialog, an RDP host that has no key: the server refused the user name and password typed; both are asked for again."},
  "passwordPromptUsernameHint": "Username (DOMAIN\\user or user@domain)",
  "@passwordPromptUsernameHint": {"description": "Password dialog: the hint inside the user name field, shown where the user name is asked for too (an RDP host with no key). DOMAIN\\user and user@domain are literal examples, not translated."},
  "screenTestRdpReachable": "Reachable through {carrier}: signed in over SSH in {sshMs}ms, and an RDP server answers at {address} in {rdpMs}ms and takes this host's way of signing in. Its certificate is checked when you connect. No username or password was sent.",
  "@screenTestRdpReachable": {"description": "Result of screenTestButton for an RDP host reached through an SSH host ({carrier}, its name): signed in over SSH in {sshMs} milliseconds; the RDP server at {address} (an address and port) answered the connection request in {rdpMs} milliseconds and takes the way of signing in this host is set to (with or without Network Level Authentication). TLS is not started by the test.", "placeholders": {"carrier": {"type": "String"}, "sshMs": {"type": "int"}, "address": {"type": "String"}, "rdpMs": {"type": "int"}}},
  "screenTestRdpReachableDirect": "Reachable: an RDP server answers in {ms}ms and takes this host's way of signing in. Its certificate is checked when you connect, which asks about a new one. No username or password was sent.",
  "@screenTestRdpReachableDirect": {"description": "Result of screenTestButton for an RDP host reached directly (no SSH host): the RDP server answered the connection request in {ms} milliseconds and takes the way of signing in this host is set to. TLS is not started by the test; the certificate is checked (and a new one asked about) when connecting.", "placeholders": {"ms": {"type": "int"}}},
  "screenTestRdpNotRdp": "Something answers at {address}, but it is not an RDP server.",
  "@screenTestRdpNotRdp": {"description": "Result of screenTestButton for an RDP host: something answered at {address} (an address and port) but not as an RDP server does.", "placeholders": {"address": {"type": "String"}}},
  "screenTestRdpNoTls": "The RDP server offers no TLS. ZestSSH connects to an RDP server only inside TLS: turn TLS on at the server.",
  "@screenTestRdpNoTls": {"description": "Result of screenTestButton for an RDP host: the server answered and offers no TLS (a very old server, or one set to RDP's own old encryption). The app connects to an RDP server only inside TLS."},
  "screenTestRdpRefused": "The RDP server refused the connection request (code {code}).",
  "@screenTestRdpRefused": {"description": "Result of screenTestButton for an RDP host: the server refused the connection request with a failure code of the protocol ({code}, a small number) that the app has no words of its own for.", "placeholders": {"code": {"type": "int"}}},
  "connectionEditRdpGraphicsNote": "Auto suits most servers. Modern also uses H.264 video where this device can decode it (Windows): sharper in motion, and more work for the processor. RemoteFX and Basic are for older servers.",
  "@connectionEditRdpGraphicsNote": {"description": "Host editor, an RDP host: under the Graphics choice (Auto, Modern, RemoteFX, Basic). Says what each is for. H.264 is a video format; RemoteFX is the name of an RDP picture format; both are not translated."},
  "connectionEditRdpDisplays": "Displays",
  "@connectionEditRdpDisplays": {"description": "Label of a choice in the host editor's remote screen section, for an RDP host: how many displays (monitors) the remote computer is asked for, 1 to 4, shown as the numbers."},
  "connectionEditRdpDisplaysNote": "How many displays the remote has. A tab or a phone shows one at a time, and the session's bar switches between them.",
  "@connectionEditRdpDisplaysNote": {"description": "Note under the Displays choice of an RDP host in the host editor (connectionEditRdpDisplays): what several displays mean (a tab on a computer, or a phone, shows one of them at a time), and that the bar over the session switches between them."},
  "connectionEditRdpRelativeMouse": "Relative mouse (for games)",
  "@connectionEditRdpRelativeMouse": {"description": "Label of a switch in the host editor's remote screen section for an RDP host, and of the same switch in a remote screen's session panel: relative mouse, where the remote is told how far the mouse moved and not where the pointer is, which games need."},
  "connectionEditRdpRelativeMouseNote": "Asks the remote to take how far the mouse moves instead of where the pointer is, as games and 3D programs need. You turn it on in the session's panel, and the menu key gets the pointer back.",
  "@connectionEditRdpRelativeMouseNote": {"description": "Note under the Relative mouse switch of an RDP host in the host editor (connectionEditRdpRelativeMouse): what it is for, that it is turned on in the session's panel, and that the menu key gives the pointer back."},
  "connectionEditRdpSound": "Play the remote's sound",
  "@connectionEditRdpSound": {"description": "A switch in the host editor's Remote Desktop section, and the same switch in a running session's menu: whether the remote computer's sound (what it would play on its own speakers) is played on this device."},
  "connectionEditRdpSoundNote": "On a computer by default, off on a phone. Nothing of this device's sound or microphone goes to the remote.",
  "@connectionEditRdpSoundNote": {"description": "The line under the switch Play the remote's sound in the host editor: by default the sound is played on a computer and not on a phone, and nothing of this device's own sound or microphone is sent to the remote computer."},
  "connectionEditRdpTextSize": "Text size on the remote",
  "@connectionEditRdpTextSize": {"description": "Label of a choice in the host editor's remote screen section for an RDP host: how large the remote computer draws its text and windows (its display scaling), chosen as the remote's own setting or a percentage."},
  "connectionEditRdpTextSizeOwn": "Auto",
  "@connectionEditRdpTextSizeOwn": {"description": "First option of the choice Text size on the remote (connectionEditRdpTextSize) of an RDP host: the app says nothing and the remote computer uses its own setting. One short word, as Auto elsewhere in the editor: it is a small pill beside percentages."},
  "connectionEditRdpTextSizePercent": "{percent}%",
  "@connectionEditRdpTextSizePercent": {"description": "An option of the choice Text size on the remote (connectionEditRdpTextSize) of an RDP host: a percentage, written as the language writes percentages. {percent} is the number, one of 100, 125, 150, 200.", "placeholders": {"percent": {"type": "int"}}},
  "connectionEditRdpTextSizeNote": "How large the remote draws its text and windows. A larger size is easier to read on a small or very sharp screen. Auto leaves it as the remote has it.",
  "@connectionEditRdpTextSizeNote": {"description": "Note under the choice Text size on the remote (connectionEditRdpTextSize) of an RDP host in the host editor: what it changes, when a larger size helps, and what its first option Auto (connectionEditRdpTextSizeOwn) does."},
  "connectionEditScreenFrameLimit": "Frame rate limit",
  "@connectionEditScreenFrameLimit": {"description": "Label of a choice in the host editor's remote screen section (VNC and RDP hosts), and of the same choice in a remote screen's session panel: the most pictures (frames) a second the app draws of the remote screen. Options: off, 60, 30, 15."},
  "connectionEditScreenFrameLimitOff": "Off",
  "@connectionEditScreenFrameLimitOff": {"description": "First option of the choice Frame rate limit (connectionEditScreenFrameLimit) for a remote screen: no limit. One short word; it is a small pill beside numbers."},
  "connectionEditScreenFrameLimitFps": "{fps} fps",
  "@connectionEditScreenFrameLimitFps": {"description": "An option of the choice Frame rate limit (connectionEditScreenFrameLimit) for a remote screen: a number of pictures (frames) a second, short, as the language abbreviates it. {fps} is the number, one of 60, 30, 15.", "placeholders": {"fps": {"type": "int"}}},
  "connectionEditScreenFrameLimitNote": "Draws at most this many pictures a second, which saves battery and processor time. The remote still sends as often as it does.",
  "@connectionEditScreenFrameLimitNote": {"description": "Note under the choice Frame rate limit (connectionEditScreenFrameLimit) of a remote screen host in the host editor: what a limit does (fewer pictures a second are drawn, which saves battery and processor time) and that the remote computer still sends as before."},
  "screenRdpNothingAnswers": "Nothing answers at {address} on {carrier}: the RDP server is not running there, or listens on another port.",
  "@screenRdpNothingAnswers": {"description": "A remote screen (RDP) reached through an SSH host did not open: the SSH host tried the screen's address ({address}) and nothing listens there (ZS-1801). {carrier} is the SSH host's name.", "placeholders": {"address": {"type": "String"}, "carrier": {"type": "String"}}},
  "connectionEditRdpAddressUser": "Only the address goes here. The account's username goes in this host's key, or is asked for when the screen opens.",
  "@connectionEditRdpAddressUser": {"description": "Host editor, an RDP host: shown under the address field when a user name was typed into it (alex@pc.example.com). The address takes no user name; the account is the host's key's, or is asked for when the screen opens."},
  "hostsSectionFoldNamed": "Hide {section}",
  "@hostsSectionFoldNamed": {"description": "What a screen reader says for the chevron before a section head of the Hosts page that folds the section away. {section} is the section's name (Workspaces, Groups, Hosts).", "placeholders": {"section": {"type": "String"}}},
  "hostsSectionUnfoldNamed": "Show {section}",
  "@hostsSectionUnfoldNamed": {"description": "What a screen reader says for the chevron before a folded section head of the Hosts page that shows the section again. {section} is the section's name.", "placeholders": {"section": {"type": "String"}}},
  "a11yColorOrange": "Orange",
  "@a11yColorOrange": {"description": "Said to a screen reader for an orange colour swatch (a host's, group's or tag's colour label)."},
  "a11yColorPurple": "Purple",
  "@a11yColorPurple": {"description": "Said to a screen reader for a purple colour swatch (a host's, group's or tag's colour label)."},
  "a11yColorPink": "Pink",
  "@a11yColorPink": {"description": "Said to a screen reader for a pink colour swatch (a host's, group's or tag's colour label)."},
  "a11yColorTeal": "Teal",
  "@a11yColorTeal": {"description": "Said to a screen reader for a teal (blue green) colour swatch (a host's, group's or tag's colour label)."},
  "a11yColorHex": "Color {hex}",
  "@a11yColorHex": {"description": "Said to a screen reader for a colour swatch whose colour has no name in the app's palette (a custom colour). {hex} is its code, e.g. #3A7BD5.", "placeholders": {"hex": {"type": "String"}}},
  "hostTagRemove": "Remove tag {tag}",
  "@hostTagRemove": {"description": "Said to a screen reader for the small cross on one of a host's tags in the host editor, which takes the tag off the host. {tag} is the tag, e.g. prod.", "placeholders": {"tag": {"type": "String"}}},
  "a11yNoticeError": "Error",
  "@a11yNoticeError": {"description": "Said to a screen reader before a notice's words where the notice is an error (its red cross icon). One word."},
  "a11yNoticeWarning": "Warning",
  "@a11yNoticeWarning": {"description": "Said to a screen reader before a notice's words where the notice is a warning (its amber triangle icon). One word."},
  "a11yNoticeSuccess": "Done",
  "@a11yNoticeSuccess": {"description": "Said to a screen reader before a notice's words where the notice says something went through (its green tick icon). One word."},
  "a11yRemoveNamed": "Remove {name}",
  "@a11yRemoveNamed": {"description": "Said to a screen reader for the small cross that removes one item from a list of chips, e.g. a saved terminal theme. {name} is the item's name.", "placeholders": {"name": {"type": "String"}}},
  "terminalReaderName": "Terminal: {name}",
  "@terminalReaderName": {"description": "What a screen reader calls a terminal (4.0 accessibility). {name} is the session's name, as its tab says it, e.g. web-01.", "placeholders": {"name": {"type": "String"}}},
  "terminalReaderHint": "New lines are read out. Read the screen lists every line.",
  "@terminalReaderHint": {"description": "A screen reader's hint on a terminal (4.0 accessibility): new lines are read out, and the action Read the screen (terminalReadScreen) lists every line."},
  "terminalReadScreen": "Read the screen",
  "@terminalReadScreen": {"description": "A terminal's action, in its menu and as a screen reader's action (4.0 accessibility): opens the terminal's lines, one to a line, to read with a screen reader or the arrow keys."},
  "terminalReaderTitle": "Screen of {name}",
  "@terminalReaderTitle": {"description": "The title of Read the screen (4.0 accessibility). {name} is the session's name, e.g. web-01.", "placeholders": {"name": {"type": "String"}}},
  "terminalReaderBlank": "Blank line",

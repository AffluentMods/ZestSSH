  "@lockoutNoProofBody": {"description": "A recovery that can only reset the account (no synced data, or no recovery proof registered); the list of what it loses follows."},
  "lockoutResetLosesData": "Your synced data is set aside, where nothing reads it, and deleted after 30 days.",
  "@lockoutResetLosesData": {"description": "What a reset loses, one point of a list."},
  "lockoutResetLosesTeams": "Your keys in your teams are dropped, and each team's owners and admins are told: someone there gives you access again.",
  "@lockoutResetLosesTeams": {"description": "What a reset loses, one point of a list."},
  "lockoutResetLosesDevices": "Every device is signed out, and each is approved again.",
  "@lockoutResetLosesDevices": {"description": "What a reset loses, one point of a list."},
  "lockoutResetKeeps": "What is on your devices stays: their hosts and keys are not touched.",
  "@lockoutResetKeeps": {"description": "What a reset keeps, the last point of the list."},
  "lockoutResetConfirm": "Reset and recover",
  "@lockoutResetConfirm": {"description": "Button: complete the recovery by resetting the account."},
  "lockoutCannotProveHere": "This device has not been signed in to this account with sync, so it cannot prove your sync password. Complete the recovery on a device that was, to keep your data, or reset the account here.",
  "@lockoutCannotProveHere": {"description": "This device does not know the account well enough to sign the recovery proof (it never registered one for it)."},
  "lockoutProofInvalid": "{count, plural, =0{That sync password did not prove the account, and it cannot be tried again: only a reset is left.} =1{That sync password did not prove the account. 1 more try, then only a reset is left.} other{That sync password did not prove the account. {count} more tries are left.}}",
  "@lockoutProofInvalid": {"description": "A wrong sync password in a recovery (code recovery-proof-invalid), with how many tries are left. {count} is a number; it also picks the plural form.", "placeholders": {"count": {"type": "int", "example": "9"}}},
  "lockoutProofClosed": "The sync password was tried too many times for this recovery. You can still go on without it, which resets the account.",

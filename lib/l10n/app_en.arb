  "monitorNoticeCritical": "{name} is critical",
  "@monitorNoticeCritical": {"description": "Title of a notice from Server Monitor: a metric of a watched host went over its critical limit. name is the host. The lines under it say which metric.", "placeholders": {"name": {"type": "String", "example": "web-01"}}},
  "monitorNoticeWarning": "{name} needs attention",
  "@monitorNoticeWarning": {"description": "Title of a notice from Server Monitor: a metric of a watched host went over its warning limit. name is the host. The lines under it say which metric.", "placeholders": {"name": {"type": "String", "example": "web-01"}}},
  "monitorNoticeNotReached": "{name} cannot be reached",

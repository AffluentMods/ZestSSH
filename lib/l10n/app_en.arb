  "iosBackgroundingHelpTitle": "iOS & SSH connections",
  "@iosBackgroundingHelpTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpIntro": "iOS suspends apps after about 30 seconds in the background. This is a platform restriction that affects all SSH clients.",
  "@iosBackgroundingHelpIntro": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatHappensTitle": "What happens?",
  "@iosBackgroundingHelpWhatHappensTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatHappensBullet1": "When you switch to another app or lock your screen, iOS suspends ZestSSH after approximately 30 seconds.",
  "@iosBackgroundingHelpWhatHappensBullet1": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatHappensBullet2": "All active SSH connections, port forwards, and SFTP transfers are disconnected by the operating system.",
  "@iosBackgroundingHelpWhatHappensBullet2": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatHappensBullet3": "Any unsaved work in remote editors (vim, nano) may be lost if the session is not recovered by the server.",
  "@iosBackgroundingHelpWhatHappensBullet3": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhyTitle": "Why does this happen?",
  "@iosBackgroundingHelpWhyTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhyBullet1": "iOS enforces strict background execution limits to preserve battery life and system resources.",
  "@iosBackgroundingHelpWhyBullet1": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhyBullet2": "Unlike Android, iOS does not allow apps to maintain persistent network connections in the background without using specific entitlements (audio, location, VoIP) that do not apply to SSH.",
  "@iosBackgroundingHelpWhyBullet2": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhyBullet3": "This is not a ZestSSH limitation -- every SSH client on iOS has this same constraint, including Termius, Prompt, and Blink Shell.",
  "@iosBackgroundingHelpWhyBullet3": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatZestDoesTitle": "What ZestSSH does",
  "@iosBackgroundingHelpWhatZestDoesTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatZestDoesBullet1": "Auto reconnect: When you return to the app, ZestSSH automatically detects disconnected sessions and reconnects them with exponential backoff.",
  "@iosBackgroundingHelpWhatZestDoesBullet1": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatZestDoesBullet2": "Session state: Your terminal scrollback and local session history are preserved even after a disconnect.",
  "@iosBackgroundingHelpWhatZestDoesBullet2": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpWhatZestDoesBullet3": "Port forward rules are saved and can be set to auto-activate on reconnect.",
  "@iosBackgroundingHelpWhatZestDoesBullet3": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpSolutionsTitle": "Recommended solutions",
  "@iosBackgroundingHelpSolutionsTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpTmuxTitle": "Use tmux or GNU screen",
  "@iosBackgroundingHelpTmuxTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpTmuxDescription": "Run a terminal multiplexer on the server. Your session persists on the server even when the SSH connection drops. Reconnect and reattach with \"tmux attach\" or \"screen -r\".",
  "@iosBackgroundingHelpTmuxDescription": {"description": "Second line or description on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpMoshTitle": "Use Mosh (mobile shell)",
  "@iosBackgroundingHelpMoshTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpMoshDescription": "Mosh keeps a session through iOS suspending ZestSSH and through changes of network: when you come back, it picks up where it was, with no new sign-in. ZestSSH has Mosh built in. The host needs mosh-server (the command below installs it on Debian and Ubuntu) and UDP ports 60000 to 61000 open.",
  "@iosBackgroundingHelpMoshDescription": {"description": "Second line or description on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpCombineBullet": "For best results, combine both: use Mosh as the transport and tmux on the server. This gives you resilient connections with persistent sessions.",
  "@iosBackgroundingHelpCombineBullet": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpNoWorkaroundsTitle": "Why we don't use background workarounds",
  "@iosBackgroundingHelpNoWorkaroundsTitle": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpNoWorkaroundsBullet1": "Some apps abuse UIBackgroundModes (like silent audio playback) to keep connections alive. Apple actively rejects apps that misuse these entitlements.",
  "@iosBackgroundingHelpNoWorkaroundsBullet1": {"description": "Title on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpNoWorkaroundsBullet2": "Using background audio or location hacks drains battery significantly and violates App Store guidelines.",
  "@iosBackgroundingHelpNoWorkaroundsBullet2": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},
  "iosBackgroundingHelpNoWorkaroundsBullet3": "We prioritize a reliable, App Store compliant experience over workarounds that could stop working with any iOS update.",
  "@iosBackgroundingHelpNoWorkaroundsBullet3": {"description": "Text on the help page about sessions in the background on an iPhone or iPad."},

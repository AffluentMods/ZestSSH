  "heldBackKeepTitle": "Keep this copy?",
  "@heldBackKeepTitle": {"description": "Title of the question before keeping one copy."},
  "heldBackKeepBody": "The copy in {vault} is saved again as your change, and the other copies are removed.",
  "@heldBackKeepBody": {"description": "Body of that question. {vault} is the vault.", "placeholders": {"vault": {"type": "String"}}},
  "heldBackRemove": "Remove",
  "@heldBackRemove": {"description": "Button on one copy in that list, and its confirm button: this copy is deleted."},
  "heldBackRemoveTitle": "Remove this copy?",
  "@heldBackRemoveTitle": {"description": "Title of the question before removing one copy."},
  "heldBackRemoveBody": "The copy in {vault} is removed. What is left is the item.",
  "@heldBackRemoveBody": {"description": "Body of that question. {vault} is the vault.", "placeholders": {"vault": {"type": "String"}}},
  "heldBackFailed": "This has not reached the team yet. It goes with the next sync.",
  "@heldBackFailed": {"description": "In that list, when a keep or remove could not be sent now. It stays on this device and goes with the next sync."},
  "storeHandoverAskTitle": "Two sets of ZestSSH data on this PC",
  "@storeHandoverAskTitle": {"description": "Windows, the Microsoft Store copy of ZestSSH at its first start after the copy from zestssh.com handed its data over, where both hold different data: title of the question which to keep."},
  "storeHandoverAskBody": "ZestSSH from zestssh.com and this ZestSSH from the Microsoft Store each hold hosts, keys and settings on this PC. Which do you want to keep? The other is set aside on this PC for 30 days, then deleted.",
  "@storeHandoverAskBody": {"description": "Body of that question. The data not kept is set aside on the PC for 30 days, then deleted (Delete all local data deletes it at once)."},
  "storeHandoverKeepStore": "Keep this app's data",
  "@storeHandoverKeepStore": {"description": "Button in that question: keep the data of this app (the Microsoft Store copy)."},
  "storeHandoverKeepWebsite": "Keep the zestssh.com app's data",
  "@storeHandoverKeepWebsite": {"description": "Button in that question: keep the data of the copy from zestssh.com."},
  "storeHandoverNoticeTitle": "One ZestSSH on this PC",
  "@storeHandoverNoticeTitle": {"description": "Title of the notices the Microsoft Store copy of ZestSSH gives about the copy from zestssh.com (removed, still there, open it once), and of the one the copy from zestssh.com gives about an older Microsoft Store copy; the notice's text is under it. Short: a notice title holds 120 characters."},
  "storeHandoverRemoved": "ZestSSH from zestssh.com was removed from this PC. This one, from the Microsoft Store, has everything it held, and keeps itself up to date.",
  "@storeHandoverRemoved": {"description": "Notice in the Microsoft Store copy after it removed the copy from zestssh.com with that copy's own uninstaller."},
  "storeHandoverNotRemoved": "ZestSSH from zestssh.com is still on this PC. Remove it in Settings, Apps, so only one ZestSSH stays.",
  "@storeHandoverNotRemoved": {"description": "Notice in the Microsoft Store copy where removing the copy from zestssh.com did not work."},
  "storeHandoverOpenWebsiteOnce": "ZestSSH from zestssh.com is also on this PC. Open it once: it brings its hosts and keys here, and then goes.",
  "@storeHandoverOpenWebsiteOnce": {"description": "Notice in the Microsoft Store copy where the copy from zestssh.com is installed and its data cannot be read from here: opening it once hands its data over."},

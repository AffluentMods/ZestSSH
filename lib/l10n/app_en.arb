  "lockoutHereDesc": "A recovery this device asked for. It can be completed from {date}.",
  "@lockoutHereDesc": {"description": "Account, Security, signed out: a recovery this device waits for. {date} is a date.", "placeholders": {"date": {"type": "String", "example": "6 November 2026"}}},
  "lockoutWaitingTitle": "Someone asked to recover your account",
  "@lockoutWaitingTitle": {"description": "Banner and notice on every signed-in device: someone asked to recover the account."},
  "lockoutWaitingBody": "On {asked}, someone asked to recover {email} because its second step was lost. Unless you cancel it, from {completes} they can turn two-step sign-in off: with the sync password they keep the data, without it the account is reset. If it was you, there is nothing to do.",
  "@lockoutWaitingBody": {"description": "Body of the banner of a waiting recovery. {asked} is a date or time. {email} is an email address. {completes} is filled in by the app; the English text shows what goes there.", "placeholders": {"asked": {"type": "String", "example": "30 October 2026"}, "email": {"type": "String", "example": "sam@example.com"}, "completes": {"type": "String", "example": "6 November 2026"}}},
  "lockoutWaitingBodyNoDate": "Someone asked to recover {email} because its second step was lost. Unless you cancel it, from {completes} they can turn two-step sign-in off: with the sync password they keep the data, without it the account is reset. If it was you, there is nothing to do.",
  "@lockoutWaitingBodyNoDate": {"description": "Body of the banner of a waiting recovery, where the day it was asked is not known. {email} is an email address. {completes} is filled in by the app; the English text shows what goes there.", "placeholders": {"email": {"type": "String", "example": "sam@example.com"}, "completes": {"type": "String", "example": "6 November 2026"}}},
  "lockoutNotMe": "This wasn't me",
  "@lockoutNotMe": {"description": "Button: cancel a recovery of the account at once, with no new sign-in."},
  "lockoutNoticeBody": "Unless you cancel it, from {date} whoever asked can turn two-step sign-in off for your account. If it was not you, cancel it now.",

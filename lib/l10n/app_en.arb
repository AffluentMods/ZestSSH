  "sftpOnlyRefusalAtOnce": "{host} closed the terminal the moment it opened. If it allows SFTP only, its files can still be opened, and it can be made SFTP only so it opens that way from now on.",
  "@sftpOnlyRefusalAtOnce": {"description": "A session's shell closed the moment it opened, before anything was typed: the host may allow SFTP only. {host} is the host's name.", "placeholders": {"host": {"type": "String"}}},
  "sftpOnlyOpenFiles": "Open its files",

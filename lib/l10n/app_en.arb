  "autoGuideUrlUserDesc": "SSH username",
  "@autoGuideUrlUserDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlPortDesc": "SSH port (default: 22)",
  "@autoGuideUrlPortDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideBatchIntro": "Batch execution lets you run the same command across multiple servers in a single request. This is ideal for fleet-wide health checks, rolling restarts, or gathering metrics.",
  "@autoGuideBatchIntro": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideBatchCommaLabel": "Host names are comma-separated:",
  "@autoGuideBatchCommaLabel": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideBatchParallelTitle": "Parallel vs. Sequential",
  "@autoGuideBatchParallelTitle": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideBatchParallelBody": "By default, batch commands run in parallel across all servers simultaneously. Set parallel=false to execute sequentially, one server at a time (useful for rolling restarts where you need to wait for each server to come back before continuing).",
  "@autoGuideBatchParallelBody": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideBatchOutputTitle": "Output format",
  "@autoGuideBatchOutputTitle": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideBatchOutputBody": "Results are grouped per server with a header line showing the host name and exit code:",
  "@autoGuideBatchOutputBody": {"description": "Text in the Automation guide (batch body)."},
  "autoGuideSnippetExampleLabel": "Example snippet named \"deploy\":",
  "@autoGuideSnippetExampleLabel": {"description": "Text in the Automation guide (snippet variables body)."},
  "autoGuideSnippetTriggerUrlLabel": "Trigger it with variables from a URL:",
  "@autoGuideSnippetTriggerUrlLabel": {"description": "Text in the Automation guide (snippet variables body)."},
  "autoGuideSnippetTaskerLabel": "Or from a Tasker intent:",
  "@autoGuideSnippetTaskerLabel": {"description": "Text in the Automation guide (snippet variables body)."},
  "autoGuideFilterIntro": "Output filters let you trim command output before it is returned to the calling app or sent to a webhook. This is useful when you only need a specific line or pattern.",
  "@autoGuideFilterIntro": {"description": "Text in the Automation guide (output filters body)."},
  "autoGuideFilterGrepDesc": "Only return lines that match this pattern (a regular expression; upper and lower case are the same)",
  "@autoGuideFilterGrepDesc": {"description": "Second line or description in the Automation guide (output filters body)."},
  "autoGuideFilterHeadDesc": "Return only the first N lines of output",
  "@autoGuideFilterHeadDesc": {"description": "Second line or description in the Automation guide (output filters body)."},
  "autoGuideFilterTailDesc": "Return only the last N lines of output",
  "@autoGuideFilterTailDesc": {"description": "Second line or description in the Automation guide (output filters body)."},
  "autoGuideFilterExamplesLabel": "Examples:",
  "@autoGuideFilterExamplesLabel": {"description": "Text in the Automation guide (output filters body)."},
  "autoGuideFilterCombined": "Filters can be combined. When multiple filters are specified, they are applied in this order: grep first, then head or tail. Output filters also work with batch execution.",
  "@autoGuideFilterCombined": {"description": "Text in the Automation guide (output filters body)."},
  "autoGuideWebhookIntro": "Add a callback extra to an Android intent (Tasker, MacroDroid) to have ZestSSH POST the results to a webhook when the command completes. A zestssh:// link's callback is ignored: a link can come from anywhere, and its question does not show where the output would go.",
  "@autoGuideWebhookIntro": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideWebhookJsonLabel": "ZestSSH sends a POST request with this JSON body:",
  "@autoGuideWebhookJsonLabel": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideWebhookReqLabel": "Requirements:",
  "@autoGuideWebhookReqLabel": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideWebhookReqs": "•  The callback URL must use HTTPS (plain HTTP is rejected)\n•  The request is fire-and-forget -- ZestSSH does not retry on failure\n•  Content-Type is application/json",
  "@autoGuideWebhookReqs": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideWebhookUseCasesLabel": "Use cases:",
  "@autoGuideWebhookUseCasesLabel": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideWebhookUseCases": "•  Post server metrics to a Slack channel\n•  Send alerts to a Discord webhook\n•  Trigger PagerDuty incidents on command failure\n•  Feed results into a monitoring dashboard\n•  Log execution history to an external database",
  "@autoGuideWebhookUseCases": {"description": "Text in the Automation guide (webhook body)."},
  "autoGuideHistoryIntro": "Every automation run is logged with its timestamp, action type, host, command, exit code, and output. The log keeps the most recent 500 entries.",
  "@autoGuideHistoryIntro": {"description": "Text in the Automation guide (history body)."},
  "autoGuideHistoryWhereLabel": "Where to find it:",
  "@autoGuideHistoryWhereLabel": {"description": "Text in the Automation guide (history body)."},
  "autoGuideHistoryWhere": "•  On a phone: Settings, then Automation, then History\n•  On a computer: Automation in the sidebar, then the Runs tab",
  "@autoGuideHistoryWhere": {"description": "Text in the Automation guide (history body)."},
  "autoGuideHistoryViewLabel": "Viewing output:",
  "@autoGuideHistoryViewLabel": {"description": "Text in the Automation guide (history body)."},
  "autoGuideHistoryView": "Tap any history entry to expand it and see the full stdout and stderr output. Long output is scrollable. You can also copy the output to the clipboard by tapping the copy icon.",
  "@autoGuideHistoryView": {"description": "Text in the Automation guide (history body)."},
  "autoGuideHistoryStorage": "The log is kept on this device, in the app's encrypted database, until you clear it. Batch executions log one entry per host.",
  "@autoGuideHistoryStorage": {"description": "Text in the Automation guide (history body)."},
  "autoGuideTroubleDisabledSymptom": "Automation is disabled",
  "@autoGuideTroubleDisabledSymptom": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleDisabledFix": "Turn automation on: on a phone under Settings, Automation; on a computer with the switch at the top of Automation. Automation is off by default for security.",
  "@autoGuideTroubleDisabledFix": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleSqueezedSymptom": "Squeezed required",
  "@autoGuideTroubleSqueezedSymptom": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleSqueezedFix": "Automation requires ZestSSH Squeezed, a one-time purchase. Go to Settings > Upgrade to buy it.",
  "@autoGuideTroubleSqueezedFix": {"description": "Text in the Automation guide (troubleshooting body), and in the Automation workflows view."},
  "autoGuideTroubleNotFoundSymptom": "Connection not found",
  "@autoGuideTroubleNotFoundSymptom": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleNotFoundFix": "The host name in your automation URL must match the name shown in ZestSSH exactly (upper and lower case are the same). Open your hosts list and check the spelling.",
  "@autoGuideTroubleNotFoundFix": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleTimeoutSymptom": "Command timed out",
  "@autoGuideTroubleTimeoutSymptom": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleTimeoutFix": "The default timeout is 30 seconds. For long-running commands, add a timeout parameter with a higher value: timeout=120 (in seconds).",
  "@autoGuideTroubleTimeoutFix": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleHostKeySymptom": "Host key verification failed",
  "@autoGuideTroubleHostKeySymptom": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleHostKeyFix": "Connect to the server manually in ZestSSH at least once and accept the host key when prompted. Automation cannot accept new host keys for security reasons.",
  "@autoGuideTroubleHostKeyFix": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideTroubleFooter": "Still stuck? Check the automation history log for detailed error messages, or visit zestssh.com/docs/automation for additional troubleshooting guides.",
  "@autoGuideTroubleFooter": {"description": "Text in the Automation guide (troubleshooting body)."},
  "autoGuideSecurityIntro": "ZestSSH automation is designed with security as a top priority. Multiple layers of protection ensure your servers stay safe:",
  "@autoGuideSecurityIntro": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecuritySqueezed": "•  Squeezed only: automation is part of ZestSSH Squeezed, and off until you turn it on.",
  "@autoGuideSecuritySqueezed": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityKillSwitch": "•  Kill switch: A master switch turns all automation off at once. While it is off, every incoming intent and link is refused, and ZestSSH says why.",
  "@autoGuideSecurityKillSwitch": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityHostKey": "•  Host key verification: Automation will not connect to a server whose host key has not been previously verified in a manual session. This prevents man-in-the-middle attacks.",
  "@autoGuideSecurityHostKey": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityNoInjection": "•  No shell injection risk: Host names and snippet names are resolved by exact match against your local database. They are never interpolated into shell commands.",
  "@autoGuideSecurityNoInjection": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityCredentials": "•  Credentials never leave secure storage: SSH passwords and private keys are stored in the platform keychain (Android Keystore / iOS Keychain / OS credential manager). Automation reads credentials at execution time and never exposes them in URLs, intents, or logs.",
  "@autoGuideSecurityCredentials": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityUriLimits": "•  URI length limits: Deep link URIs are capped at 2048 bytes and individual query parameters at 256 characters to prevent overflow attacks.",
  "@autoGuideSecurityUriLimits": {"description": "Text in the Automation guide (security body)."},
  "autoGuideSecurityHttps": "•  HTTPS-only webhooks: Callback URLs must use HTTPS. Plain HTTP endpoints are rejected to protect command output in transit.",
  "@autoGuideSecurityHttps": {"description": "Text in the Automation guide (security body)."},

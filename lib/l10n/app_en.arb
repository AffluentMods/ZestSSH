  "connHostKeyDeclined": "The key that {host} showed was not accepted, so the connection was not made. Nothing was sent to it.",
  "@connHostKeyDeclined": {"description": "Text shown for HostKeyRefusal.declinedNew while a terminal session connects or runs. {host} is a host (its name or address).", "placeholders": {"host": {"type": "String", "example": "192.0.2.10"}}},
  "connHostKeyChangedDeclined": "{host} showed another key than the one this device trusts for it, and that key was not accepted. Nothing was sent to it. A host's key changes when the host is set up anew, and when something stands between this device and the host: check the key before you accept it.",
  "@connHostKeyChangedDeclined": {"description": "Text shown for HostKeyRefusal.declinedChanged while a terminal session connects or runs. {host} is a host (its name or address).", "placeholders": {"host": {"type": "String", "example": "192.0.2.10"}}},
  "errSignInWayKey": "a key",
  "@errSignInWayKey": {"description": "Text in an error message (translated from a technical error)."},
  "errSignInWayPassword": "a password",
  "@errSignInWayPassword": {"description": "Text in an error message (translated from a technical error)."},
  "errSignInWayQuestions": "answers to its own questions",
  "@errSignInWayQuestions": {"description": "Text in an error message (translated from a technical error)."},
  "errSignInTakesOnly": "The server takes only this for a sign-in: {ways}. This sign-in has none of it, so nothing was sent to the server.",
  "@errSignInTakesOnly": {"description": "Second line or description in an error message (translated from a technical error). {ways} is the ways said.", "placeholders": {"ways": {"type": "String", "example": "a key, a password"}}},
  "errSignInTakesNothing": "The server takes no way of signing in for this user, so nothing was sent to it.",
  "@errSignInTakesNothing": {"description": "Second line or description in an error message (translated from a technical error)."},
  "errSignInAlsoTakes": "The server also takes: {ways}.",
  "@errSignInAlsoTakes": {"description": "Text in an error message (translated from a technical error). {ways} is the ways said.", "placeholders": {"ways": {"type": "String", "example": "a key, a password"}}},
  "connHostKeyNotSigned": "The host showed a key and could not prove that the key is its own, so the connection was not made. Nothing was sent to it. A host that holds its key can always prove that: this happens when something stands between this device and the host and answers in its place, and with a host whose SSH server is broken.",
  "@connHostKeyNotSigned": {"description": "Text shown for SSHHostkeyFault.notSigned while a terminal session connects or runs."},
  "connHostKeyNoKey": "The host showed something that is not a key a host can have, so the connection was not made. Nothing was sent to it. The connection log says what was wrong with it. This happens when something stands between this device and the host and answers in its place, and with a host whose SSH server is broken.",
  "@connHostKeyNoKey": {"description": "Text shown for SSHHostkeyFault.noKey while a terminal session connects or runs."},
  "connHostKeyFailedAtNewKeys": "While this session was open, the host asked for new keys, and the key it showed then was not the one the session began with, or it could not prove that it was. The session was ended. A host keeps its key while a session is open: connect again to see which key it shows now, and check it before you accept it.",
  "@connHostKeyFailedAtNewKeys": {"description": "Text while a terminal session connects or runs, and in the view shown when a connection is lost."},
  "connKexGroupTooShort": "The host chose a key exchange group of {bits} bits, and nothing under {least} bits is taken, so the connection was not made. Nothing was sent to the host. What a session carries under a group that short can be read later by whoever records it and has the means to break the group. The host's SSH server has to offer longer groups, or a newer key exchange.",
  "@connKexGroupTooShort": {"description": "A connection that was not made because the host named a Diffie-Hellman group shorter than the app takes for the key exchange; bits is the length of that group, least the shortest taken.", "placeholders": {"bits": {"type": "int", "example": "1024"}, "least": {"type": "int", "example": "2048"}}},
  "connKexGroupOutdated": "This host offers only an outdated key exchange (a group of {bits} bits; none under {least} bits is taken), so no connection was made. Nothing was sent to it. Update its SSH server if you can. For an old server that cannot be updated, Compatibility mode (under \"{where}\") in this host's settings connects to it. Not recommended: whoever records the session and breaks such a group can read it.",
  "@connKexGroupOutdated": {"description": "A connection that was not made because the host named a Diffie-Hellman group shorter than the app takes, of a length Compatibility mode takes, with the mode off: the host offers only an outdated key exchange. bits is the length of that group, least the shortest taken, where the place of the Compatibility mode switch in the host editor.", "placeholders": {"bits": {"type": "int", "example": "1024"}, "least": {"type": "int", "example": "2048"}, "where": {"type": "String", "example": "Auth / Show advanced options"}}},
  "connKeyCouldNotSign": "The key could not be used to sign in: what it signed did not check against the key itself, so it was not sent to the host. A key file that is damaged, or that was made wrongly, does this. Import the key again from where it was made, or use another key.",
  "@connKeyCouldNotSign": {"description": "A sign-in that was not made because the signature the key produced did not verify against its own public half (a damaged or wrongly made RSA key file); nothing was sent to the host."},
  "connectionLostDamaged": "What came from {host} did not pass its check, so nothing of it was used and the connection was ended.",
  "@connectionLostDamaged": {"description": "A session whose connection was ended because a packet from the host failed its integrity check (it was changed or damaged on the way).", "placeholders": {"host": {"type": "String", "example": "web-01"}}},
  "connectionLostDamagedTip": "A connection that is failing does this, and so does something that interferes with it on the way. If it keeps happening on one network, try another.",
  "@connectionLostDamagedTip": {"description": "What a failed integrity check can mean, under connectionLostDamaged."},
  "connPacketDamaged": "What came from the host did not pass its check, so nothing of it was used and the connection was not made. Either it was changed or damaged on the way, or the host's SSH server and this app do not protect what they send the same way. Try again. If it happens every time, and on another network as well, it is the host's SSH server and this app that do not work together.",
  "@connPacketDamaged": {"description": "A connection that was not made because a packet from the host failed its integrity check while the host was being signed in to."},
  "zestMonitorTipNotTriedAgain": "It is not tried again by itself: every try would end the same way. Refresh to try again.",
  "@zestMonitorTipNotTriedAgain": {"description": "Server Monitor, under why a check of a host failed: the host is held back, no timer will dial it again, and refreshing tries it again."},
  "zestMonitorTipHostKeyNew": "This device has not seen this host's key before. Open a terminal to it and check the key: monitoring begins once the key is trusted.",
  "@zestMonitorTipHostKeyNew": {"description": "Server Monitor: the host showed a key this device has never trusted (a first connection), so it was not signed in to in the background."},
  "connStrictOrderBroken": "Something came in the key exchange with the host that does not belong there, and the host and this app had agreed to take nothing of the kind (the strict key exchange). The connection was not made, and nothing was sent to the host. An attack on the connection looks like this (the one known as Terrapin), and so does an SSH server, or a proxy in front of it, that does not keep to the order. If it happens on one network only, do not use that network for this.",
  "@connStrictOrderBroken": {"description": "A connection that was not made because the server broke the order of the strict key exchange (the Terrapin countermeasure): a packet came before its proposal, or one that is no message of the exchange."},
  "connKexUnanswered": "The host sent its SSH version and then stopped answering: its part of the key exchange never came, so no connection was made and nothing of a sign-in was sent. A firewall that inspects SSH (a SonicWall with DPI-SSH on, for example) does this when it does not take what this app offers. If Compatibility mode is off for this host, turning it on (under \"{where}\") may get through: it adds older algorithms after the ones offered now. Otherwise, ask whoever runs the firewall to let SSH to this host through without inspection.",
  "@connKexUnanswered": {"description": "A connection that was not made because the host sent its SSH version and then no proposal for the key exchange in the time it is given (the SSH inspection of a firewall such as a SonicWall with DPI-SSH does this). where is the place of the Compatibility mode switch in the host editor.", "placeholders": {"where": {"type": "String", "example": "Auth / Show advanced options"}}},
  "errSignInRsaOnlySha1": "This server takes an RSA key only with the first kind of RSA signature (ssh-rsa, made with SHA-1), which this app makes in Compatibility mode only. Your RSA key was not offered to it. Edit this host and turn on Compatibility mode (under \"{where}\"), or sign in with a key of another kind. Signatures made with SHA-1 are less secure, so turn the mode on only for servers that cannot be updated.",
  "@errSignInRsaOnlySha1": {"description": "Text in an error message (translated from a technical error). {where} is the compatibility mode place.", "placeholders": {"where": {"type": "String", "example": "Auth"}}},
  "errSignInRsaNotTaken": "This server has said which kinds of key it takes, and an RSA key is not among them. Your RSA key was not offered to it. Sign in with a key of another kind, an Ed25519 key for example.",
  "@errSignInRsaNotTaken": {"description": "Text in an error message (translated from a technical error)."},
  "connKeyUnreadable": "The private key of \"{label}\" on this device cannot be read: the file is damaged, or it is of a kind ZestSSH does not know. Open the key and import its private key again. Nothing was sent to the host.",
  "@connKeyUnreadable": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connCertUnusable": "The certificate of the key \"{label}\" cannot be used: it was made for another key, or it is damaged. Add the right one in the key's editor on a phone, or on a computer's Keys page with Import certificate or Generate certificate. The key was not offered without its certificate.",
  "@connCertUnusable": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connSignInNotLoaded": "ZestSSH could not get \"{label}\" ready to sign in: reading it on this device failed. Connect again; if it keeps happening, restart ZestSSH. Nothing was sent to the host.",
  "@connSignInNotLoaded": {"description": "Error text while a terminal session connects or runs. {label} is the key label.", "placeholders": {"label": {"type": "String", "example": "deploy key"}}},
  "connSavedPasswordUnreadable": "The saved password could not be read on this device, so it is asked for here.",
  "@connSavedPasswordUnreadable": {"description": "Text while a terminal session connects or runs."},
  "errAlgorithmNoneInCommonDesc": "Could not agree on a {algoType} algorithm with {host}. The server offers only {offers}, and ZestSSH has none of them.",
  "@errAlgorithmNoneInCommonDesc": {"description": "Second line or description in an error message (translated from a technical error). {algoType} is the algo type. {host} is a host (its name or address). {offers} is the list of server offers.", "placeholders": {"algoType": {"type": "String", "example": "cipher"}, "host": {"type": "String", "example": "web-01"}, "offers": {"type": "String", "example": "3des-cbc, blowfish-cbc"}}},
  "errAlgorithmNoneInCommonTip": "No setting in ZestSSH changes this: it has none of what this server offers, with Compatibility mode or without. The server has to offer something ZestSSH has: whoever runs it can add a newer algorithm to its SSH settings, or update its SSH server. The details of this error list what ZestSSH offers.",
  "@errAlgorithmNoneInCommonTip": {"description": "Text in an error message (translated from a technical error)."},
  "connectionLostAtJumpHost": "The connection to {host} goes through the jump host {jump}, and it was the connection to that jump host that ended.",
  "@connectionLostAtJumpHost": {"description": "Text in the view shown when a connection is lost. {host} is a host (its name or address). {jump} is the jump.", "placeholders": {"host": {"type": "String", "example": "web-01"}, "jump": {"type": "String", "example": "vpn-gateway"}}},
  "connJumpHostKeyFailedAtNewKeys": "The jump host {jump} asked for new keys while its connection was open, and the key it showed then was not the one that connection began with, or it could not prove that it was. The connection was ended. A host keeps its key while a connection is open: connect again to see which key {jump} shows now, and check it before you accept it.",

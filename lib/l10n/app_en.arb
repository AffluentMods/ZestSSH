  "autoGuideWhatIsP1": "ZestSSH Automation lets you run SSH commands on your servers from other apps, shortcuts and schedules, without opening a terminal. Commands run in the background, and on Android their results go back to the app that asked.",
  "@autoGuideWhatIsP1": {"description": "Text in the Automation guide."},
  "autoGuideWhatIsUseCasesLabel": "Use cases include:",
  "@autoGuideWhatIsUseCasesLabel": {"description": "Text in the Automation guide."},
  "autoGuideWhatIsUseCases": "•  Scheduled server health checks (disk, memory, uptime)\n•  NFC tag-triggered diagnostics (tap your phone to a tag)\n•  One-tap deployment shortcuts on your home screen\n•  Monitoring pipelines that post results to Slack or Discord\n•  Siri voice commands: \"Hey Siri, restart my web server\"",
  "@autoGuideWhatIsUseCases": {"description": "Text in the Automation guide."},
  "autoGuideProBadge": "Automation is a ZestSSH Squeezed feature",
  "@autoGuideProBadge": {"description": "Text in the Automation guide."},
  "autoGuideMacroIntro": "MacroDroid is a popular Android automation app. Follow these steps to trigger ZestSSH commands from any MacroDroid macro:",
  "@autoGuideMacroIntro": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroStep1": "Open MacroDroid and tap \"Add Macro\" (the + button).",
  "@autoGuideMacroStep1": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroStep2": "Add a Trigger. Choose any trigger you like -- for example, \"Day/Time\" to run a command every morning at 8 AM, or \"NFC Tag\" to execute when you tap a physical tag.",
  "@autoGuideMacroStep2": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroStep3": "Add an Action. Navigate to: Applications > Open Website / URL.",
  "@autoGuideMacroStep3": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroStep4": "In the URL field, paste a ZestSSH automation URL with your API key in it (key=...). Make sure \"Use Built-in Browser\" is unchecked so the URL opens directly in ZestSSH, which asks you before it runs it.",
  "@autoGuideMacroStep4": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroStep5": "Save the macro and give it a descriptive name.",
  "@autoGuideMacroStep5": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroExampleLabel": "Example -- check disk space every morning:",
  "@autoGuideMacroExampleLabel": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideMacroTip": "Tip: A link always asks you before it runs. For a macro that runs with nobody there (a morning check, for example), use MacroDroid's \"Send Intent\" action with the intents under Tasker setup instead.",
  "@autoGuideMacroTip": {"description": "Text in the Automation guide (macro droid body)."},
  "autoGuideTaskerIntro": "Tasker can launch ZestSSH automation via Android Intents for tighter integration and richer result handling.",
  "@autoGuideTaskerIntro": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerStep1": "Create a new Task in Tasker. Tap \"+\" to add an action and select \"System > Send Intent\".",
  "@autoGuideTaskerStep1": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerStep2": "Set the Action field to the intent action for the operation you want to perform (see table below).",
  "@autoGuideTaskerStep2": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerStep3": "Add each extra in an Extra field of its own, as key:value. For example:\n  key:<API key>\n  connection_id:MyServer\n  command:uptime",
  "@autoGuideTaskerStep3": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerStep4": "Set the Target to \"Activity\" and save the task.",
  "@autoGuideTaskerStep4": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerActionsLabel": "Available intent actions:",
  "@autoGuideTaskerActionsLabel": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerOpenVsConnect": "Use OPEN (not CONNECT) when you want port-forward tunnels to come up. CONNECT runs an echo and disconnects, while OPEN creates a real session - the same code path as tapping a host in the app - so any port-forward rules you marked \"auto-start\" are activated as part of the connect.",
  "@autoGuideTaskerOpenVsConnect": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideTaskerResults": "Results are returned in the intent extras as \"stdout\" and \"exit_code\". Use Tasker's \"Return\" variable to read them in subsequent actions.",
  "@autoGuideTaskerResults": {"description": "Text in the Automation guide (tasker body)."},
  "autoGuideIosIntro": "On iPhone and iPad, a shortcut opens ZestSSH with a zestssh:// link, and Siri runs a shortcut by its name.",
  "@autoGuideIosIntro": {"description": "Text in the Automation guide."},
  "autoGuideIosStep1": "Open the Shortcuts app and create a new shortcut.",
  "@autoGuideIosStep1": {"description": "Text in the Automation guide."},
  "autoGuideIosStep2": "Tap \"Add Action\" and add \"Open URLs\", with a zestssh:// link:\n•  zestssh://connect?name=web-01 opens a saved host\n•  zestssh://execute?connection=web-01&command=uptime&key=YOUR_KEY runs a command\n•  zestssh://snippet?connection=web-01&name=nightly-backup&key=YOUR_KEY runs a saved snippet",
  "@autoGuideIosStep2": {"description": "Text in the Automation guide."},
  "autoGuideIosStep3": "A link that runs something needs an API key (made under Automation, API keys), as key=. Opening a host needs none.",
  "@autoGuideIosStep3": {"description": "Text in the Automation guide."},
  "autoGuideIosStep4": "Give your shortcut a name. This name becomes the Siri voice command. For example, name it \"Check server status\" and say: \"Hey Siri, check server status.\"",
  "@autoGuideIosStep4": {"description": "Text in the Automation guide."},
  "autoGuideIosExampleLabel": "Example: \"Goodnight servers\" shortcut",
  "@autoGuideIosExampleLabel": {"description": "Text in the Automation guide."},
  "autoGuideIosExampleBody": "Create a shortcut named \"Goodnight servers\" that opens a zestssh://snippet link for a snippet called \"nightly-backup\" on your production server. Say \"Hey Siri, goodnight servers\" before bed: ZestSSH opens, asks whether to run it, and runs it once you say yes.",
  "@autoGuideIosExampleBody": {"description": "Text in the Automation guide."},
  "autoGuideIosTip": "Tip: ZestSSH asks you before it runs what a link asks for. A link holds your API key (key=...), so do not share a shortcut that has one.",
  "@autoGuideIosTip": {"description": "Text in the Automation guide."},
  "autoGuideIosLimitation": "iOS limitation: ZestSSH runs what a shortcut asks for only while it is open, and asks you each time before it runs it, so nothing runs by itself in the background or on a schedule. A Shortcuts automation at a set time opens the request, and it waits for your answer.",
  "@autoGuideIosLimitation": {"description": "Text in the Automation guide."},
  "autoGuideUrlIntro": "ZestSSH registers the zestssh:// URL scheme. Any app that can open a URL can trigger automation. All parameters are passed as query string values; a link that runs something carries your API key (key=...), and ZestSSH asks you before it runs it.",
  "@autoGuideUrlIntro": {"description": "Text in the Automation guide (URL scheme body)."},
  "autoGuideUrlExecuteLabel": "Execute a command:",
  "@autoGuideUrlExecuteLabel": {"description": "Text in the Automation guide (URL scheme body)."},
  "autoGuideUrlConnectionDesc": "The host's name (exact match; upper and lower case are the same)",
  "@autoGuideUrlConnectionDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlCommandDesc": "The shell command to execute",
  "@autoGuideUrlCommandDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlTimeoutDesc": "Max seconds to wait (default: 30)",
  "@autoGuideUrlTimeoutDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlSnippetLabel": "Run a saved snippet:",
  "@autoGuideUrlSnippetLabel": {"description": "Text in the Automation guide (URL scheme body)."},
  "autoGuideUrlNameDesc": "Snippet name (exact match)",
  "@autoGuideUrlNameDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlVarKeyDesc": "Snippet template variable (see Snippet Variables)",
  "@autoGuideUrlVarKeyDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlBatchLabel": "Batch execute across multiple servers:",
  "@autoGuideUrlBatchLabel": {"description": "Text in the Automation guide (URL scheme body)."},
  "autoGuideUrlConnectionsDesc": "The names of your hosts, separated by commas",
  "@autoGuideUrlConnectionsDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlParallelDesc": "Run simultaneously (default: true)",
  "@autoGuideUrlParallelDesc": {"description": "Second line or description in the Automation guide (URL scheme body)."},
  "autoGuideUrlConnectLabel": "Quick connect (verify reachability):",
  "@autoGuideUrlConnectLabel": {"description": "Text in the Automation guide (URL scheme body)."},
  "autoGuideUrlHostDesc": "Hostname or IP address",

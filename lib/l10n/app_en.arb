  "@connectionTestSftpWorks": {"description": "Host editor: the full connection test of a host that is SFTP only succeeded: it signed in, opened SFTP and listed the first folder, and asked for no terminal. {jumpNote} is an optional sentence about jump hosts, with its own leading space. {tcpMs} is a number. {totalMs} is a number.", "placeholders": {"tcpMs": {"type": "int"}, "totalMs": {"type": "int"}, "jumpNote": {"type": "String"}}},
  "sessionFilesOnlyLine": "This session is files only (SFTP): it has no terminal.",
  "@sessionFilesOnlyLine": {"description": "The line a session that is files only (an SFTP-only host) shows where a terminal would be, dimmed in its terminal and on a phone."},
  "sessionFilesOnlyLineFtps": "This session is files only (FTPS): it has no terminal.",
  "@sessionFilesOnlyLineFtps": {"description": "The line a session that is files only over FTPS (an FTPS host's) shows where a terminal would be: in its terminal, on a phone, in its tab's tag. FTPS stays as it is."},
  "hostSftpOnlyNoTerminal": "This host is SFTP only: it gives no terminal.",

  "dangerExplainCriticalDelete": "`{match}` deletes everything under that folder without asking, and it cannot be undone. Check the path before you go on.",
  "@dangerExplainCriticalDelete": {"description": "What the highlighted part does and what to do. match = the part as typed, quoted.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainForcedDeleteLongFlags": "`{match}` deletes folders and everything in them without asking. Check what it names before you go on.",
  "@dangerExplainForcedDeleteLongFlags": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainFindDelete": "`{match}` deletes whatever it finds under that folder without asking, and it cannot be undone. Check the path and what it looks for before you go on.",
  "@dangerExplainFindDelete": {"description": "What find with -delete does there, quoting the part found, and what to do. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainRootGuardOff": "`{match}` turns off the check that stops rm deleting the whole system. Go on only if you mean to.",
  "@dangerExplainRootGuardOff": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainFormatDisk": "`{match}` formats a disk and erases everything on it. Check the device name with lsblk first.",
  "@dangerExplainFormatDisk": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainWipeDisk": "`{match}` erases the marks that say what is on a disk or partition, so what is on it can no longer be found. Check the device name with lsblk first.",
  "@dangerExplainWipeDisk": {"description": "What wipefs does, quoting the part found, and what to do. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainShred": "`{match}` overwrites what it names so that it cannot be recovered, and with -u deletes the file as well. Check that name before you go on.",
  "@dangerExplainShred": {"description": "What shred does, quoting the part found, and what to do. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainDiskWrite": "`{match}` writes straight onto a disk, over what is on it. Check the device name with lsblk first.",
  "@dangerExplainDiskWrite": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainDdOverwrite": "`{match}` writes over the file or disk it is aimed at, and what was there is gone. Check that name before you go on.",
  "@dangerExplainDdOverwrite": {"description": "What dd aimed at a file or a disk does, quoting the part of the command found, and what to do. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainDiskRead": "`{match}` reads a disk or a file byte by byte and passes it on. That changes nothing where it reads, but it can take long: check where the output goes.",
  "@dangerExplainDiskRead": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainForkBomb": "`{match}` starts copies of itself until the host stops answering, and often only a restart brings it back. There is rarely a reason to run this.",
  "@dangerExplainForkBomb": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainOpenPermissions": "`{match}` lets everyone read, change and run every file under that folder. Give only the rights that are needed instead.",
  "@dangerExplainOpenPermissions": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainMoveToNull": "`{match}` does not throw a file away. Run as root it replaces /dev/null with that file, and programs that write to /dev/null then write into it; without root it is refused. Use rm if you mean to delete it.",
  "@dangerExplainMoveToNull": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainPipeToShell": "`{match}` runs whatever it receives as commands, without showing it first. If you can, download it and read it before you run it.",
  "@dangerExplainPipeToShell": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainDecodeToShell": "`{match}` decodes hidden text and runs it as commands, so you cannot see what runs. Decode it without the shell first and read it.",
  "@dangerExplainDecodeToShell": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainInterpreterOneLiner": "`{match}` runs a small program written out on this line. What runs is the text after it: read it before you go on.",
  "@dangerExplainInterpreterOneLiner": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainShellString": "`{match}` starts a new shell and runs the quoted text as a command. What runs is the part in quotes: read it before you go on.",
  "@dangerExplainShellString": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainAuthorizedKeys": "`{match}` is the list of keys that may sign in to this account. A key added there gives whoever holds it access: go on only if you know the key.",
  "@dangerExplainAuthorizedKeys": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainCrontab": "`{match}` changes the commands this account runs on a schedule, and they keep running after you sign out. Check what it adds or removes.",
  "@dangerExplainCrontab": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainStartupFile": "`{match}` adds to a file that runs whenever a shell starts, so what it adds runs again at every sign-in. Check the line it adds.",
  "@dangerExplainStartupFile": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainShutdown": "`{match}` shuts the host down. Every session on it ends, and it may take someone at the machine to start it again.",
  "@dangerExplainShutdown": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainReboot": "`{match}` restarts the host. Every session on it ends until it is back. Check that this is the host you mean.",
  "@dangerExplainReboot": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainHalt": "`{match}` halts the host: it stops running and every session on it ends. It may take someone at the machine to start it again.",
  "@dangerExplainHalt": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainPowerOff": "`{match}` powers the host off. Every session on it ends, and it may take someone at the machine to turn it on again.",
  "@dangerExplainPowerOff": {"description": "As dangerExplainCriticalDelete. {match} is the match.", "placeholders": {"match": {"type": "String"}}},
  "dangerExplainTooLong": "`{match}` goes on too long to check to the end: only the start of it was read, and the rest could do anything. Read it before you go on.",
  "@dangerExplainTooLong": {"description": "As dangerExplainCriticalDelete: the start of a text too long to read to its end. {match} is the match.", "placeholders": {"match": {"type": "String"}}},

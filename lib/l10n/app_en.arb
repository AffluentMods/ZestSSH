  "jumpHostCircleInNetwork": "The jump hosts that the network {network} sets for {host} go in a circle: {hop} comes up a second time on the way. Open the host overrides of {network} and change them.",
  "@jumpHostCircleInNetwork": {"description": "The jump hosts a network profile sets for a host name the same host twice, or the host itself (hop).", "placeholders": {"host": {"type": "String", "example": "db-primary"}, "hop": {"type": "String", "example": "bastion"}, "network": {"type": "String", "example": "Office"}}},
  "sftpErrNotAFile": "There is nothing to download of {target}: on the server it is a device, a pipe or a socket, not a file.",
  "@sftpErrNotAFile": {"description": "A download was asked of something on the server that is not a regular file (a device such as /dev/zero, a named pipe, a socket). target is the name in quotes, or the words for \"the item\".", "placeholders": {"target": {"type": "String", "example": "“zero”"}}},
  "sftpErrWrittenInPlace": "On the server, {target} could only be written where it is, so what it holds there now is part of the new content. Save or upload it again.",
  "@sftpErrWrittenInPlace": {"description": "Follows the sentence of what went wrong. A file on the server could not be replaced by a complete new copy (its folder cannot be written to, or a new file would belong to someone else), so the new content was written into the existing file, and that was interrupted: the file on the server is now incomplete. target is the name in quotes, or the words for \"the item\".", "placeholders": {"target": {"type": "String", "example": "“site.conf”"}}},
  "sftpErrSetAside": "On the server, {target} was moved to {aside} to make room for the new file, and could not be put back. Nothing is lost: what it held is in {aside}, the new content in {staged}, both beside it. Rename the one you want back to its name.",
  "@sftpErrSetAside": {"description": "Follows the sentence of what went wrong. On a server that cannot replace a file in one step, the old file was moved to another name, the new file could not be given its name, and the old one could not be moved back (the connection ended in between). {target} is the file as the message names it, {aside} and {staged} are file names beside it.", "placeholders": {"target": {"type": "String"}, "aside": {"type": "String"}, "staged": {"type": "String"}}},
  "pfTroubleTitle": "{name}: connections are not getting through",
  "@pfTroubleTitle": {"description": "Title of a notice: a port forward is running, but the connections made through it fail. name is the forward.", "placeholders": {"name": {"type": "String", "example": "Postgres on db-01"}}},
  "pfHostPassesNothingOn": "The host does not pass connections on: forwarding is turned off there, or not allowed for this account or key.",
  "@pfHostPassesNothingOn": {"description": "Why connections through a running port forward fail: the host refuses to forward (turned off in its settings, or not allowed for the account or key)."},
  "pfHostCannotConnect": "The host could not connect to {target}.",
  "@pfHostCannotConnect": {"description": "Why connections through a running port forward fail: the host tried to connect to the target of the forward and could not.", "placeholders": {"target": {"type": "String", "example": "10.50.0.7:5432"}}},
  "pfHostDidNotOpen": "The host did not open the connection.",
  "@pfHostDidNotOpen": {"description": "Why connections through a running port forward fail: the host refused to open the connection, for a reason other than the two above."},
  "pfHostSaid": "What it said: {reason}",
  "@pfHostSaid": {"description": "Follows one of the sentences about a port forward: what the host itself said about it, as it sent it. {reason} is the reason.", "placeholders": {"reason": {"type": "String", "example": "Connection refused"}}},
  "pfNothingAnswersThere": "This device could not connect to {target}, where the forward hands its connections on.",
  "@pfNothingAnswersThere": {"description": "Why connections through a running port forward from the host fail: this device could not connect to the address the forward leads to. {target} is the bind port.", "placeholders": {"target": {"type": "String", "example": "127.0.0.1:3000"}}},
  "sftpErrCameShort": "{expected} bytes were sent and {actual} arrived.",
  "@sftpErrCameShort": {"description": "A transfer (an upload, a download, a copy, a save from the editor) ended with another number of bytes at its far end than were sent. Followed by a sentence that says what that left: sftpErrNotKept, or sftpErrWrittenInPlace. {expected} is a number. {actual} is a number.", "placeholders": {"expected": {"type": "int", "example": "4096"}, "actual": {"type": "int", "example": "1024"}}},
  "sftpErrNotKept": "What arrived was not kept, and anything it was to replace is untouched.",
  "@sftpErrNotKept": {"description": "Follows sftpErrCameShort: the incomplete copy was removed, and the file it was going to replace (if there was one) is exactly as it was."},
  "zestMonitorTipSignInRefused": "The host refused the sign-in.",
  "@zestMonitorTipSignInRefused": {"description": "Server Monitor, why a host cannot be checked: the host (or a jump host on the way, as the sentence after it says) took none of the keys or the password it was offered. Followed by the rejected user and by what the check failed with."},
  "zestMonitorTipNotReached": "The host could not be reached.",
  "@zestMonitorTipNotReached": {"description": "Server Monitor, why a host cannot be checked: the connection to it could not be made (a time-out, a refused connection, no route, a name that is not found). Followed by a sentence that says which."},
  "zestMonitorTipCheckFailed": "The check could not be made.",

  "screenTestButton": "Test the screen",
  "@screenTestButton": {"description": "Host editor, a remote screen (VNC, 4.0): the button that tests it without sending a VNC password (through its SSH host: signs in there, opens the channel to the screen and reads the VNC server's greeting)."},
  "screenTestReachable": "Reachable through {carrier}: signed in over SSH in {sshMs}ms, and a VNC server (RFB {version}) answers at {address} in {vncMs}ms, offering {types}. No VNC password was sent.",
  "@screenTestReachable": {"description": "Result of screenTestButton for a screen reached through an SSH host ({carrier}, its name): signed in in {sshMs} milliseconds; the VNC server at {address} (an address and port, or a socket path) answered in {vncMs} milliseconds with its RFB protocol version ({version}, like 3.8) and the security types it offers ({types}: protocol names like None, VncAuth, VeNCrypt, untranslated).", "placeholders": {"carrier": {"type": "String"}, "sshMs": {"type": "int"}, "address": {"type": "String"}, "version": {"type": "String"}, "vncMs": {"type": "int"}, "types": {"type": "String"}}},
  "screenTestReachableDirect": "Reachable: a VNC server (RFB {version}) answers in {ms}ms and offers VeNCrypt with {subtypes}. Its certificate is checked when you connect, which asks about a new one. No password was sent.",
  "@screenTestReachableDirect": {"description": "Result of screenTestButton for a screen reached directly (no SSH host, VeNCrypt TLS only): the VNC server answered in {ms} milliseconds with its RFB version ({version}) and offers VeNCrypt with the subtypes the app takes ({subtypes}: X509None, X509Vnc, X509Plain, untranslated). TLS is not started by the test; the certificate is checked (and a new one asked about) when connecting.", "placeholders": {"ms": {"type": "int"}, "version": {"type": "String"}, "subtypes": {"type": "String"}}},
  "screenTestNotVnc": "Something answers at {address}, but it is not a VNC server.",
  "@screenTestNotVnc": {"description": "Result of screenTestButton: something answered at {address} (an address and port, or a socket path) but not with a VNC server's greeting.", "placeholders": {"address": {"type": "String"}}},
  "screenTestTurnedAway": "The VNC server turned the connection away: {reason}",
  "@screenTestTurnedAway": {"description": "Result of screenTestButton: the VNC server refused the connection before offering any security type, and said why ({reason}, the server's own words, often English).", "placeholders": {"reason": {"type": "String"}}},
  "screenTestNothingTaken": "The VNC server offers {types}: none of them is one this app accepts (None, VncAuth, VeNCrypt or AppleRemoteDesktop).",
  "@screenTestNothingTaken": {"description": "Result of screenTestButton: the VNC server offers only security types the app does not take ({types}: protocol names, untranslated). Followed by the code ZS-1804.", "placeholders": {"types": {"type": "String"}}},
  "screenTestNoTls": "The VNC server offers {offered}. Reached directly, a screen needs VeNCrypt with a certificate (X509None, X509Vnc or X509Plain); turn it on at the server, or reach the screen through an SSH host.",
  "@screenTestNoTls": {"description": "Result of screenTestButton for a screen reached directly: the VNC server does not offer VeNCrypt with a certificate ({offered}: what it offers, protocol names, untranslated). Followed by the code ZS-1804.", "placeholders": {"offered": {"type": "String"}}},
  "settingsScreenClipboardDefault": "Clipboard on your own hosts",
  "@settingsScreenClipboardDefault": {"description": "Settings, Remote screens (VNC, 4.0): a switch, on by default: whether a remote screen of the person's own space (not a team's) shares the clipboard both ways when no other choice was made for it."},
  "settingsScreenClipboardDefaultDesc": "Whether a remote screen of your own space shares the clipboard both ways. A host set otherwise in its editor keeps its own; a team's hosts follow their team's rules.",
  "@settingsScreenClipboardDefaultDesc": {"description": "Under settingsScreenClipboardDefault."},
  "jumpHostNotSsh": "{hop} is a remote screen or an FTPS host, so {host} cannot connect through it. Open {host} and pick an SSH host under Connect via, or Direct.",
  "@jumpHostNotSsh": {"description": "A host is set to connect through a jump host that is a remote screen (VNC) or an FTPS host, which cannot carry an SSH connection. \"Connect via\" is the editor's field, \"Direct\" its choice for no jump host (as in jumpHostGoneDirect). {hop} is the jump host, {host} the host.", "placeholders": {"hop": {"type": "String"}, "host": {"type": "String"}}},
  "xProgramToolsMissing": "{host} has no Xvnc or no xauth, which an X program needs. Install them there, then open the program again:\n{command}",
  "@xProgramToolsMissing": {"description": "An X program (4.0: a graphical program run on an SSH host in a private X server there and shown in a screen tab) could not start: the host lacks TigerVNC's Xvnc or xauth. {host} is the SSH host, {command} the install command for its package manager (shown on its own line, as it is, for the person to run there; never translated).", "placeholders": {"host": {"type": "String"}, "command": {"type": "String"}}},
  "xProgramToolsMissingNoInstaller": "{host} has no Xvnc or no xauth, which an X program needs. Install TigerVNC's Xvnc and xauth there with its package manager, then open the program again.",
  "@xProgramToolsMissingNoInstaller": {"description": "As xProgramToolsMissing, for a host whose package manager the app does not know, so no install command is shown. {host} is the SSH host.", "placeholders": {"host": {"type": "String"}}},
  "xProgramFailed": "The private X server for the program did not start on {host}: {detail}",
  "@xProgramFailed": {"description": "An X program (4.0) could not start: the private X server (Xvnc) on the SSH host did not start. {host} is the SSH host, {detail} what the host's script said, in English (a short technical reason).", "placeholders": {"host": {"type": "String"}, "detail": {"type": "String"}}},
  "xProgramNotFound": "{program} was not found on {host}. Check its name, or install it there.",
  "@xProgramNotFound": {"description": "An X program (4.0) ended as it started with exit status 127: the SSH host has no program by that name. {program} is the program's name (its first word, e.g. xterm), {host} the SSH host.", "placeholders": {"program": {"type": "String"}, "host": {"type": "String"}}},
  "xProgramEndedAtOnce": "{program} ended as it started (exit status {status}). If it hands its window to a copy already running, ask it for a new one.",
  "@xProgramEndedAtOnce": {"description": "An X program (4.0) ended within a moment of starting, so there was no window to show. {program} is the program's name (e.g. xterm), {status} its exit status (a number).", "placeholders": {"program": {"type": "String"}, "status": {"type": "String"}}},
  "xProgramTabLabel": "{program} on {host}",
  "@xProgramTabLabel": {"description": "The tab (and session) name of an X program (4.0: a graphical program run on an SSH host and shown in a screen tab). {program} is the program's name (e.g. xterm), {host} the SSH host's name. Keep it short.", "placeholders": {"program": {"type": "String"}, "host": {"type": "String"}}},
  "hostMenuOpenXProgram": "Open an X program…",

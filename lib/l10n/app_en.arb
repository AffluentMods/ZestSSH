  "@backupWeakensAskBeforeTrusting": {"description": "A tick in the restore preview: what taking this setting from the backup does."},
  "backupWeakensDangerousCommands": "Stop warning before commands that can do damage",
  "@backupWeakensDangerousCommands": {"description": "A tick in the restore preview: what taking this setting from the backup does."},
  "backupWeakensSecurityAlerts": "Turn off security alerts",
  "@backupWeakensSecurityAlerts": {"description": "A tick in the restore preview: what taking this setting from the backup does."},
  "backupWeakensClipboard": "Let hosts write to this device's clipboard",
  "@backupWeakensClipboard": {"description": "A tick in the restore preview: what taking this setting from the backup does."},
  "backupWeakensSnippetConfirm": "Stop asking before a snippet that can do damage runs",
  "@backupWeakensSnippetConfirm": {"description": "A tick in the restore preview: what taking this setting from the backup does."},
  "csvImpKeyPassword": "Send the password saved with {key} to {address}. Left unticked, this host has no key and asks when you connect.",
  "@csvImpKeyPassword": {"description": "CSV import: a tick on a row whose key would send this host a password of the person's. {key} is the key's name, {address} the host's.", "placeholders": {"key": {"type": "String"}, "address": {"type": "String"}}},
  "signInNoPort": "ZestSSH could not open a port on this computer for the browser to come back to, so the sign-in was not started.",
  "@signInNoPort": {"description": "Signing in on a computer: no port for the browser to come back to. The code ZS-1301 follows it."},
  "backupRestoreStartsForward": "starts a port forward when it connects",
  "@backupRestoreStartsForward": {"description": "Restore preview, what a host does: a port forward set On for a network starts by itself."},
  "profileHiddenTitle": "Your data is hidden, not locked",
  "@profileHiddenTitle": {"description": "A notice after a sign-out: the account's data could only be hidden."},
  "profileHiddenBody": "This computer could not tell ZestSSH Cloud the secret that locks this account's data, so its key is still here and the app only hides it. Sign in again while online to lock it properly.",
  "@profileHiddenBody": {"description": "Why the account's data could only be hidden at sign-out, and what to do."},
  "profileHiddenCopyGoneBody": "ZestSSH Cloud no longer holds the secret that locks this account's data on this computer: it was deleted under Locked copies on your computers. So its key is still here and the app only hides the data. Sign in again to lock it with a new secret.",
  "@profileHiddenCopyGoneBody": {"description": "A notice after the person's own sign-out on a computer, under profileHiddenTitle: ZestSSH Cloud was asked before the sign-out and no longer holds the locked copy's secret for this computer (someone deleted it under Locked copies on your computers on another computer), so the data was hidden, its key kept, instead of being locked for good. The next sign-in makes a new copy."},
  "profileHiddenUnreachableBody": "This computer could not ask ZestSSH Cloud whether it still holds the secret that locks this account's data: it was offline, or ZestSSH Cloud did not answer. So the data was not locked: its key is still here and the app only hides it. To lock it, sign in again and sign out while online.",
  "@profileHiddenUnreachableBody": {"description": "A notice after the person's own sign-out on a computer, under profileHiddenTitle: before signing out the app asks ZestSSH Cloud whether it still holds the locked copy's secret, and it could not (no internet, or no answer), so the data was hidden, its key kept on this computer, instead of locked. A sign-out made online locks it. The code ZS-1305 follows it."},
  "profileAccountGoneKeptBody": "This account no longer exists at ZestSSH Cloud, so its data on this computer could never be opened again once locked. It stays here as guest data.",
  "@profileAccountGoneKeptBody": {"description": "A notice after the person's own sign-out on a computer, under accountDeleteKeptLocalSnack: ZestSSH Cloud said the account was deleted (from another device), so locking its data would have locked it for good; it was kept as guest data instead."},
  "profileCopyLostTitle": "This account's old data cannot be opened",
  "@profileCopyLostTitle": {"description": "A notice after a sign-in: the account's old data can no longer be opened."},
  "profileCopyLostBody": "The locked copy of this account's data on this computer was deleted in Account, so it can never be opened. A new, empty profile was made. What you synced comes back with sync.",
  "@profileCopyLostBody": {"description": "Why, and what happened instead."},
  "profileCannotOpenTitle": "Your data on this computer did not open",
  "@profileCannotOpenTitle": {"description": "The title when a sign-in could not open the account's data."},
  "profileCannotOpenOffline": "ZestSSH Cloud holds what opens this account's data on this computer, and could not be reached. Nothing changed.",
  "@profileCannotOpenOffline": {"description": "ZestSSH Cloud could not be reached at a sign-in; what to do."},
  "profileCannotOpenSignInAgain": "Opening this account's data on this computer takes a sign-in from the last ten minutes. Nothing changed. Sign in again.",
  "@profileCannotOpenSignInAgain": {"description": "The secret wants a newer sign-in."},
  "profileCannotOpenBroken": "What ZestSSH Cloud holds for this account does not open its data on this computer. Nothing changed. Contact support with this code.",
  "@profileCannotOpenBroken": {"description": "What ZestSSH Cloud holds does not open the data."},
  "profileCannotOpenOther": "The data of this account on this computer did not open. Nothing changed. Try again, or contact support with this code.",
  "@profileCannotOpenOther": {"description": "The data did not open for another reason."},
  "teamSetAsideTitle": "A team's data here was set aside",
  "@teamSetAsideTitle": {"description": "A notice: a team's database on this computer was set aside."},
  "teamSetAsideBody": "Its key on this computer could not be read, so the team is being fetched again from ZestSSH Cloud. Changes made here that never reached ZestSSH Cloud are not in what comes back. The old file is kept for 30 days and then deleted: to get it back before that, write to support with this code.",
  "@teamSetAsideBody": {"description": "Why, what happens now and what is lost."},
  "signOutLocksBody": "Your hosts, keys and settings stay on this computer, locked: they open again when you sign in to this account. Until then the app shows guest data.",
  "@signOutLocksBody": {"description": "What signing out does on a computer, in the sign-out questions."},
  "signOutSessionsClose": "{count, plural, =1{1 session is open. It closes when you sign out.} other{{count} sessions are open. They close when you sign out.}}",
  "@signOutSessionsClose": {"description": "Said before a sign-out on a computer where sessions are open. {count} is the number of open sessions; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "accountSignOutDescLocks": "Signs this computer out of your account. Your hosts and keys stay here, locked, and open again when you sign in. To take them off, use Delete all local data.",
  "@accountSignOutDescLocks": {"description": "The sign-out row on a computer."},
  "deleteLocalWhichTitle": "Delete what?",
  "@deleteLocalWhichTitle": {"description": "The question of Delete all local data with other profiles on the computer."},
  "deleteLocalWhichBody": "This profile, or everything on this computer? Everything also removes the data of {accounts} and any guest data, and turns the app lock off.",
  "@deleteLocalWhichBody": {"description": "Which other accounts Everything would remove.", "placeholders": {"accounts": {"type": "String"}}},
  "deleteLocalWhichBodyGuest": "This profile, or everything on this computer? Everything also removes the other data kept here, and turns the app lock off.",
  "@deleteLocalWhichBodyGuest": {"description": "The same where the only other data is no account's."},
  "deleteLocalThisProfile": "This profile",
  "@deleteLocalThisProfile": {"description": "A choice: only the profile on screen."},
  "deleteLocalEverything": "Everything on this computer",
  "@deleteLocalEverything": {"description": "A choice: everything on this computer."},
  "deleteLocalEverythingSure": "This deletes every profile on this computer with its hosts, keys and settings, and the app lock. What was not synced is lost. This cannot be undone.",
  "@deleteLocalEverythingSure": {"description": "Asked once more before everything goes."},
  "deleteLocalWhichBodySomeoneElses": "Only this profile can be deleted from here: someone else's accounts are on this computer, and Everything would delete their data too. Each of theirs goes only after its own sign-in: sign in as it, then remove it from this computer.",
  "@deleteLocalWhichBodySomeoneElses": {"description": "Delete all local data where this computer holds someone else's accounts: only the profile on screen can go, and why."},
  "deleteLocalAgentKeysStay": "Keys you gave the system's SSH agent could not be taken back from it just now, so ssh on this computer may still sign in with them. ZestSSH keeps a note of which keys they are and takes them back as soon as it can reach the agent. Delete anyway?",
  "@deleteLocalAgentKeysStay": {"description": "Delete all local data: keys given to the system's SSH agent could not be taken back first; asked before anything goes."},
  "databaseErrorOpenOther": "Open another profile",
  "@databaseErrorOpenOther": {"description": "A button on the screen of a database that did not open."},
  "olderDataTitle": "Data from an older version",
  "@olderDataTitle": {"description": "A notice: an older version of the app left data at the old place."},
  "olderDataBody": "{count, plural, =1{An older version of ZestSSH was used here and left 1 host.} other{An older version of ZestSSH was used here and left {count} hosts.}}",
  "@olderDataBody": {"description": "The notice's line. {count} is the number of hosts; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "olderDataUnreadable": "An older version of ZestSSH was used here and left data that cannot be read.",
  "@olderDataUnreadable": {"description": "The notice's line where it cannot be read."},
  "olderDataAction": "Choose",
  "@olderDataAction": {"description": "The notice's button."},
  "olderDataQuestion": "{count, plural, =1{An older version of ZestSSH left 1 host on this computer. Bring it into this profile, or delete it? It is never taken in by itself.} other{An older version of ZestSSH left {count} hosts on this computer. Bring them into this profile, or delete them? They are never taken in by themselves.}}",
  "@olderDataQuestion": {"description": "The question: bring them in or delete them. {count} is the number of hosts; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "olderDataBring": "Bring into this profile",
  "@olderDataBring": {"description": "A button: bring an older version's data into this profile."},
  "olderDataDeleteInstead": "Delete it",
  "@olderDataDeleteInstead": {"description": "A button: delete an older version's data instead."},
  "olderDataBrought": "It is in this profile now.",
  "@olderDataBrought": {"description": "Said when it is done."},
  "olderDataNotBrought": "That did not work, and nothing was changed. Try again, or copy the details for support.",
  "@olderDataNotBrought": {"description": "Said when it failed."},
  "olderDataDeleteTitle": "Delete the older version's data?",
  "@olderDataDeleteTitle": {"description": "Asked before an older version's data is deleted."},
  "olderDataDeleteBody": "What the older version left on this computer is deleted. This cannot be undone. Nothing in your profiles changes.",
  "@olderDataDeleteBody": {"description": "What goes, and what does not."},
  "signInSessionsClose": "{count, plural, =1{1 session is open. It closes when you sign in.} other{{count} sessions are open. They close when you sign in.}}",
  "@signInSessionsClose": {"description": "Said before a sign-in on a computer where sessions are open. {count} is the number of open sessions; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "movingDataMessage": "Moving your data to its new place. Do not close ZestSSH.",
  "@movingDataMessage": {"description": "On the screen while the device moves to profiles, at the first start of a new version."},
  "databaseErrorSetAside": "Set this aside and start fresh",
  "@databaseErrorSetAside": {"description": "A button: moves data that did not open to a folder of its own, deleting nothing."},
  "databaseErrorSetAsideTitle": "Set this aside?",
  "@databaseErrorSetAsideTitle": {"description": "Title of the question before setting data aside."},
  "databaseErrorSetAsideBody": "What is here moves to a folder of its own on this computer, and nothing is deleted. ZestSSH starts fresh, and what you synced comes back with sync. It then tells you how to get the old data back, or delete it.",
  "@databaseErrorSetAsideBody": {"description": "The question before setting data aside."},
  "databaseErrorSetAsideFailed": "It could not be set aside, and nothing was deleted. Close what may hold the files, then try again, or copy the details for support.",
  "@databaseErrorSetAsideFailed": {"description": "Setting data aside failed."},
  "profileSetAsideTitle": "Earlier data was set aside",
  "@profileSetAsideTitle": {"description": "A notice at each start while data set aside is here."},
  "profileSetAsideBody": "It did not open, so it was moved to a folder of its own on this computer, and nothing was deleted. Put it back to try it again, or delete it if you do not need it.",
  "@profileSetAsideBody": {"description": "The notice about data set aside; its code follows it."},
  "profileSetAsideDeleteTitle": "Delete the data that was set aside?",
  "@profileSetAsideDeleteTitle": {"description": "Title of the question before deleting data that was set aside."},
  "profileSetAsideDeleteBody": "It is deleted from this computer. This cannot be undone. Nothing else here changes.",
  "@profileSetAsideDeleteBody": {"description": "The question before deleting data that was set aside."},
  "olderDataBodyKeys": "{count, plural, =1{An older version of ZestSSH was used here and left 1 key.} other{An older version of ZestSSH was used here and left {count} keys.}}",
  "@olderDataBodyKeys": {"description": "A notice: an older version left keys and no hosts. {count} is the number of keys; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "olderDataQuestionKeys": "{count, plural, =1{An older version of ZestSSH left 1 key on this computer. Bring it into this profile, or delete it? It is never taken in by itself.} other{An older version of ZestSSH left {count} keys on this computer. Bring them into this profile, or delete them? They are never taken in by themselves.}}",
  "@olderDataQuestionKeys": {"description": "The question: an older version left keys and no hosts. {count} is the number of keys; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "keychainFileFailed": "ZestSSH could not use its keychain file on this computer, and nothing in it was changed. Close what may hold the file (a backup tool, a virus scanner), check that it is not read-only, and try again.",
  "@keychainFileFailed": {"description": "The encrypted file that holds the secrets on Windows could not be read or written; its code follows it."},
  "olderDataLocked": "An older version of ZestSSH left data on this computer behind its app lock, so this version cannot read what it holds. It stays as it is until you say.",
  "@olderDataLocked": {"description": "The notice, and its question, when an older version left data behind its own app lock: it cannot be read here."},
  "olderDataLeave": "Leave it",
  "@olderDataLeave": {"description": "Button: keep what an older version left as it is, and decide later."},
  "olderDataDeleteUnreadBody": "This version cannot read it, so it cannot say what is in it: every host, key and password it holds goes with it. This cannot be undone. If you are not sure, leave it.",
  "@olderDataDeleteUnreadBody": {"description": "Asked before deleting what an older version left when it cannot be read: says plainly what goes."},
  "keychainSetAsideTitle": "Start without this file?",
  "@keychainSetAsideTitle": {"description": "Asked before setting aside the keychain file on Windows that does not open."},
  "keychainSetAsideBody": "The file that holds the secrets kept on this computer does not open. If you just changed your Windows password or just signed in to Windows, wait a minute and try again. If it never opens, it can stay beside a new one: nothing is deleted, and ZestSSH starts fresh without its keys. What you synced comes back with sync, and support can help with the old file: write with this code.",
  "@keychainSetAsideBody": {"description": "What setting aside the keychain file means, and what to try first. Ends with an error code."},
  "profileSetAsideQuestion": "Put it back and try it again, or delete it? To put it back ZestSSH closes: open ZestSSH again and it is there. What stands in its place is set aside in turn, so nothing is lost.",
  "@profileSetAsideQuestion": {"description": "The question on the notice of data that was set aside: put it back, or delete it."},
  "profileSetAsidePutBack": "Put it back",
  "@profileSetAsidePutBack": {"description": "Button: put back the data that was set aside. The app closes to do it."},
  "profilePutBackFailed": "It could not be put back, and nothing was deleted. Close what may hold the files, then try again. If it keeps failing, write to support with this code.",
  "@profilePutBackFailed": {"description": "Said when data that was set aside could not be put back. Ends with an error code."},
  "guestDataTitle": "Guest data on this computer",
  "@guestDataTitle": {"description": "Title of the question about data on this computer that belongs to no account, and of its row on the account page."},
  "guestDataQuestion": "{count, plural, =1{This computer has 1 host that belongs to no account. Bring it into {account}, with its saved passwords, keys and session logs? It then syncs with that account and locks when you sign out. Or keep it as guest data: it stays as it is, apart from the account, and you can bring it in later from the account page.} other{This computer has {count} hosts that belong to no account. Bring them into {account}, with their saved passwords, keys and session logs? They then sync with that account and lock when you sign out. Or keep them as guest data: they stay as they are, apart from the account, and you can bring them in later from the account page.}}",
  "@guestDataQuestion": {"description": "The question, for hosts. {account} is the address of the account signed in.", "placeholders": {"count": {"type": "int"}, "account": {"type": "String"}}},
  "guestDataQuestionKeys": "{count, plural, =1{This computer has 1 key that belongs to no account. Bring it into {account}? It then syncs with that account and locks when you sign out. Or keep it as guest data: it stays as it is, apart from the account, and you can bring it in later from the account page.} other{This computer has {count} keys that belong to no account. Bring them into {account}? They then sync with that account and lock when you sign out. Or keep them as guest data: they stay as they are, apart from the account, and you can bring them in later from the account page.}}",
  "@guestDataQuestionKeys": {"description": "The question where there are keys and no hosts. {account} is the address of the account signed in.", "placeholders": {"count": {"type": "int"}, "account": {"type": "String"}}},
  "guestDataThisAccount": "this account",
  "@guestDataThisAccount": {"description": "What stands for the account in the question where its address is not known."},
  "guestDataKeep": "Keep as guest data",
  "@guestDataKeep": {"description": "Button, the first answer: nothing moves."},
  "guestDataBring": "Bring into this account",
  "@guestDataBring": {"description": "Button: guest data comes into the account."},
  "guestDataBrought": "They are in this account now, with their saved passwords and keys, and the guest data is empty.",
  "@guestDataBrought": {"description": "Said once it has come in."},
  "guestDataNotBrought": "They could not be brought in, and the guest data is as it was. Try again from the account page, or copy the details for support.",
  "@guestDataNotBrought": {"description": "Said where it could not come in. Details to copy go with it."},
  "guestDataRowDesc": "{count, plural, =1{1 host here belongs to no account. Bring it into this account, or keep it as guest data.} other{{count} hosts here belong to no account. Bring them into this account, or keep them as guest data.}}",
  "@guestDataRowDesc": {"description": "The row on the account page: what is there, and what the button does.", "placeholders": {"count": {"type": "int"}}},
  "guestDataRowDescKeys": "{count, plural, =1{1 key here belongs to no account. Bring it into this account, or keep it as guest data.} other{{count} keys here belong to no account. Bring them into this account, or keep them as guest data.}}",
  "@guestDataRowDescKeys": {"description": "The same where there are keys and no hosts. {count} is the number of keys; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "guestDataFilesHeld": "Its hosts and keys are in this account now, but another program holds a session log or recording, so the guest data stays for now. Close that program and try again from the account page.",
  "@guestDataFilesHeld": {"description": "Bringing guest data into an account: its hosts and keys came, and another program holds one of its session logs or recordings, so guest data stays until it is tried again."},
  "guestDataKindsStayed": "Its hosts and keys are in this account now, but the guest data also holds something that cannot come with them, so it stays as well. Copy the details for support.",
  "@guestDataKindsStayed": {"description": "Bringing guest data into an account: its hosts and keys came, and it also holds rows nothing can carry (the details name them), so guest data stays."},
  "guestDataGoesLead": "If you bring this in, these do not come and are deleted with the guest data:",
  "@guestDataGoesLead": {"description": "Comes after the question about guest data, above a list of what does not come. Shown only where there is something on that list."},
  "guestDataGoesApiKeys": "{count, plural, =1{1 automation API key (a task that uses it then shows that it needs a key)} other{{count} automation API keys (a task that uses one then shows that it needs a key)}}",
  "@guestDataGoesApiKeys": {"description": "A line of the list of what does not come when guest data is brought in: automation API keys. {count} is the number of API keys; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "guestDataGoesBackups": "{count, plural, =1{1 backup destination} other{{count} backup destinations}}",
  "@guestDataGoesBackups": {"description": "A line of the list of what does not come when guest data is brought in: places automatic backups were sent to. {count} is the number of backup destinations; it also picks the plural form.", "placeholders": {"count": {"type": "int"}}},
  "guestDataGoesDeletedKeys": "{count, plural, =1{1 key you deleted from this account, with its private key} other{{count} keys you deleted from this account, with their private keys}}",
  "@guestDataGoesDeletedKeys": {"description": "A line of the list of what does not come when guest data is brought in: SSH keys the person deleted from the account after the guest copy last changed, so the deletion stands.", "placeholders": {"count": {"type": "int"}}},
  "guestDataGoesThemes": "{count, plural, =1{1 custom theme, as this account has another by that name} other{{count} custom themes, as this account has others by those names}}",
  "@guestDataGoesThemes": {"description": "A line of the list of what does not come when guest data is brought in: custom themes the account has another of by the same name.", "placeholders": {"count": {"type": "int"}}},
  "guestDataGoesOthers": "Saved password managers, a Prometheus server, pinned hosts and workspaces, where it has them",
  "@guestDataGoesOthers": {"description": "A line of the list of what does not come when guest data is brought in, with no number. It names kinds the guest data may have only some of."},
  "guestDataBroughtSome": "They are in this account now, with their saved passwords and keys, apart from what the question listed, and the guest data is empty.",
  "@guestDataBroughtSome": {"description": "Said once guest data has come in, where the question listed things that did not come."},
  "accountPasswordLinkOtherWayTitle": "The link could not be sent from here",
  "@accountPasswordLinkOtherWayTitle": {"description": "Asked when ZestSSH Cloud could not send the link to choose a password from a computer."},
  "accountPasswordLinkOtherWayBody": "ZestSSH Cloud is busy or out of reach, so it did not send the email. The sign-in page on zestssh.com can send it another way: open it and choose Forgot password?",
  "@accountPasswordLinkOtherWayBody": {"description": "What happened, and the other way: the website's sign-in page. Forgot password? is the English label of that page's link, which stays in English."},
  "accountPasswordLinkOpenSite": "Open zestssh.com",
  "@accountPasswordLinkOpenSite": {"description": "Button: opens the sign-in page on zestssh.com in the browser."},
  "accountListLabel": "Accounts on this computer",
  "@accountListLabel": {"description": "What the panel of the account row is called, for a screen reader."},
  "accountRowInUse": "In use",
  "@accountRowInUse": {"description": "The account row's list: the account on screen."},
  "accountRowSignedIn": "Signed in",
  "@accountRowSignedIn": {"description": "The account row's list: an account still signed in here, which opens at once."},
  "accountRowAsksSignIn": "Signed in, asks for its sign-in",
  "@accountRowAsksSignIn": {"description": "The account row's list: signed in here but someone else's, so picking it asks for that account's sign-in."},
  "accountRowSignedOut": "Signed out, locked",
  "@accountRowSignedOut": {"description": "The account row's list: signed out; its data stays here, locked, until it signs in."},
  "accountRowLost": "Can no longer be opened",
  "@accountRowLost": {"description": "The account row's list: its locked copy was deleted, so its data here can never open. Remove is all that is left."},
  "accountRowKeptGuest": "Set aside",
  "@accountRowKeptGuest": {"description": "The account row's list: guest data set aside when a deleted account's data became the guest data."},
  "accountAddAction": "Add account",
  "@accountAddAction": {"description": "The account row's list: signs in another account without signing out."},
  "accountManageAction": "Manage account",
  "@accountManageAction": {"description": "The account row's list: opens the account's page."},
  "accountRemoveAction": "Remove from this computer",
  "@accountRemoveAction": {"description": "Tooltip beside an account in the account row's list: deletes its data on this computer. The account itself stays."},
  "accountSwitchTitle": "Switch to {account}?",
  "@accountSwitchTitle": {"description": "Title of what is said first where sessions are open. {account} is an address or Guest.", "placeholders": {"account": {"type": "String"}}},
  "accountSwitchSessionsClose": "{count, plural, =1{1 session is open. It closes, and what it runs on the host ends unless tmux or screen keeps it. Connect again after the switch.} other{{count} sessions are open. They close, and what they run on their hosts ends unless tmux or screen keeps it. Connect again after the switch.}}",
  "@accountSwitchSessionsClose": {"description": "Said before a switch of account on a computer where sessions are open: what happens to them.", "placeholders": {"count": {"type": "int"}}},
  "accountSwitchConfirm": "Switch",
  "@accountSwitchConfirm": {"description": "Button: goes on with the switch."},
  "accountSwitching": "Opening {account}",
  "@accountSwitching": {"description": "Shown while the other account opens.", "placeholders": {"account": {"type": "String"}}},
  "accountSwitchedTo": "You are in {account} now.",
  "@accountSwitchedTo": {"description": "Said when the switch is done. {account} is the account.", "placeholders": {"account": {"type": "String"}}},
  "accountSwitchFailedBody": "That account did not open, so you stay where you are, and nothing was lost. Try again.",
  "@accountSwitchFailedBody": {"description": "A switch of account that stopped."},
  "accountSwitchWrongAccount": "That sign-in was another account's, not {account}. Nothing changed. Try again, and sign in as {account}.",
  "@accountSwitchWrongAccount": {"description": "The browser signed in to another account than the one picked. {account} is the one picked.", "placeholders": {"account": {"type": "String"}}},
  "accountsFullTitle": "This computer holds five accounts",
  "@accountsFullTitle": {"description": "Title when a sixth account is added. Five is the limit."},
  "accountsFullBody": "Five is the most a computer keeps, and guest data does not count. To add another, open the account row at the bottom left and choose Remove from this computer beside one you no longer use here.",
  "@accountsFullBody": {"description": "Says the limit and how to remove an account, at the sixth."},
  "accountWhoseTitle": "Whose account is this?",
  "@accountWhoseTitle": {"description": "Asked by Add account before its sign-in."},
  "accountWhoseBody": "Your own accounts open for each other at once. Someone else's asks for its own sign-in each time, either way, so that two people can share this computer.",
  "@accountWhoseBody": {"description": "What each answer means: a switch between one's own accounts is instant; someone else's asks for its sign-in."},
  "accountWhoseMine": "Another account of mine",
  "@accountWhoseMine": {"description": "Answer: the account is another of the person's own."},
  "accountWhoseOther": "Someone else's",
  "@accountWhoseOther": {"description": "Answer: the account belongs to another person."},
  "accountRemoveTitle": "Remove {account} from this computer?",
  "@accountRemoveTitle": {"description": "Title of Remove from this computer. {account} is its address.", "placeholders": {"account": {"type": "String"}}},
  "accountRemoveBody": "Its hosts, keys, settings, team data, logs, recordings and automatic backups on this computer are deleted, and what never synced is lost. What it synced stays at ZestSSH Cloud and comes back when it signs in here again. The account itself stays.",
  "@accountRemoveBody": {"description": "What goes and what stays on the cloud."},
  "accountRemoveSomeoneElses": "{name} is someone else's account on this computer. To remove it, sign in as it first (pick it in this list), then remove it.",
  "@accountRemoveSomeoneElses": {"description": "Remove from this computer, picked for an account that is someone else's here (another person's than the account on screen, or from guest data where the computer holds more than one person's): it is removed only after its own sign-in. {name} is the name.", "placeholders": {"name": {"type": "String", "example": "sam@example.com"}}},
  "accountRemoveCopyStays": "It is signed out, so ZestSSH Cloud's locked copy for this computer stays on its list until you delete it there. It opens nothing any more.",
  "@accountRemoveCopyStays": {"description": "Added where the account is signed out: it has no session to delete its locked copy with."},
  "accountRemoveGuestOpens": "It is in use now: guest data opens in its place.",
  "@accountRemoveGuestOpens": {"description": "Added where the account removed is the one on screen."},
  "accountRemoved": "{account} was removed from this computer.",
  "@accountRemoved": {"description": "Said when it is done. {account} is the account.", "placeholders": {"account": {"type": "String"}}},
  "accountRemoveLater": "Its data no longer opens, and its folder goes the next time the app starts.",
  "@accountRemoveLater": {"description": "Said when something holds a file of the folder being removed."},
  "lockedCopiesTitle": "Locked copies on your computers",
  "@lockedCopiesTitle": {"description": "A row on the account page: what ZestSSH Cloud keeps so that a computer can open this account's data after a sign-in."},
  "lockedCopiesDesc": "What lets each computer open this account's data after a sign-in. ZestSSH Cloud keeps a secret for each, and never the data.",
  "@lockedCopiesDesc": {"description": "What the row is. It is also the list's subtitle."},
  "lockedCopiesNone": "None yet.",
  "@lockedCopiesNone": {"description": "The list when it is empty."},
  "lockedCopiesFailed": "The list could not be read. Hosts on this computer connect as usual.",
  "@lockedCopiesFailed": {"description": "The list could not be read."},
  "lockedCopyThisComputer": "This computer: {platform}, made {day}",
  "@lockedCopyThisComputer": {"description": "A line of the list: this computer's own copy. {platform} is Windows, macOS or Linux. {day} is a date as ZestSSH Cloud wrote it.", "placeholders": {"platform": {"type": "String"}, "day": {"type": "String"}}},
  "lockedCopyOnComputer": "{platform}, made {day}",
  "@lockedCopyOnComputer": {"description": "A line of the list: another computer's copy. {platform} is the platform name. {day} is a day.", "placeholders": {"platform": {"type": "String"}, "day": {"type": "String"}}},
  "lockedCopyDeleteTitle": "Delete this locked copy?",
  "@lockedCopyDeleteTitle": {"description": "Asked before a locked copy is deleted."},
  "lockedCopyDeleteBody": "The copy on that computer can then never be opened, and what it holds there that never synced is lost. What it synced stays at ZestSSH Cloud.",
  "@lockedCopyDeleteBody": {"description": "Said first: the copy on that computer can then never be opened."},
  "lockedCopyConfirmAbout": "Deleting a locked copy takes a recent sign-in.",
  "@lockedCopyConfirmAbout": {"description": "Why a sign-in is asked for, before a locked copy is deleted."},
  "lockedCopyDeleted": "The locked copy was deleted.",
  "@lockedCopyDeleted": {"description": "Said when it is done."},
  "lockedCopyNotDeleted": "The locked copy was not deleted. Try again.",
  "@lockedCopyNotDeleted": {"description": "Said when it did not work."},

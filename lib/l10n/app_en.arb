  "xProgramEndedStatus": "{program} ended (exit status {status}). Its screen closed with it.",
  "@xProgramEndedStatus": {"placeholders": {"program": {"type": "String"}, "status": {"type": "int"}}, "description": "Under the title of an X program's tab once the program has ended: the program's name (xterm) and its exit status."},
  "xProgramEndedPlain": "{program} ended. Its screen closed with it.",

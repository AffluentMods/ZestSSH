  "hostMenuOpenConsole": "Open console",
  "@hostMenuOpenConsole": {"description": "Menu item on a host that was imported from a Proxmox account and is one of its virtual machines or containers: opens that guest's console (its screen, as Proxmox's own web page shows it) in a remote screen tab, through the Proxmox account, without SSH."},
  "consoleTabLabel": "{host} console",

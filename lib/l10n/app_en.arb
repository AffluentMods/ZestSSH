  "@proxmoxConsolePermission": {"description": "Why a Proxmox guest's console did not open: the account's API token may not open this guest's console. VM.Console is the name of the Proxmox permission, keep it as it is."},
  "proxmoxConsoleNotFound": "This virtual machine or container is no longer where it was imported from.",
  "@proxmoxConsoleNotFound": {"description": "Why a Proxmox guest's console did not open: the virtual machine or container is no longer where the import found it (deleted, or moved to another node of the cluster)."},
  "proxmoxConsoleCertificate": "Proxmox's certificate is not the one confirmed for this account. Nothing was sent to it.",
  "@proxmoxConsoleCertificate": {"description": "Why a Proxmox guest's console did not open: the server's certificate is not the one the person confirmed when the Proxmox account was added (it was renewed, or the address now leads to another server). Nothing was sent to it."},
  "proxmoxConsoleOffline": "Proxmox does not answer.",
  "@proxmoxConsoleOffline": {"description": "Why a Proxmox guest's console did not open: the Proxmox server did not answer (offline, or not reachable from this network)."},
  "proxmoxConsoleUnexpected": "Proxmox's answer could not be used. The connection log has the details.",
  "@proxmoxConsoleUnexpected": {"description": "Why a Proxmox guest's console did not open: the server answered something the app could not use. The details are in the connection log."},
  "xProgramDialogTitle": "Open an X program",

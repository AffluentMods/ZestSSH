  "autoGuideTitle": "Guia de automação",
  "autoGuideReferenceTitle": "Referência de automação",
  "autoGuideIntro": "Tudo o que você precisa para acionar comandos SSH a partir de aplicativos externos, atalhos e tarefas agendadas.",
  "autoGuideSectionWhatIs": "O que é Automação?",
  "autoGuideSectionMacroDroid": "Configuração do MacroDroid",
  "autoGuideSectionTasker": "Configuração do Tasker",
  "autoGuideSectionIos": "Atalhos do iOS e Siri",
  "autoGuideSectionUrlScheme": "Referência do esquema de URL",

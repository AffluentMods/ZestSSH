  "autoGuideTitle": "Guida all'automazione",
  "autoGuideReferenceTitle": "Riferimento per l'automazione",
  "autoGuideIntro": "Tutto ciò che ti serve per attivare comandi SSH da app esterne, scorciatoie e attività pianificate.",
  "autoGuideSectionWhatIs": "Che cos'è l'automazione?",
  "autoGuideSectionMacroDroid": "Configurazione di MacroDroid",
  "autoGuideSectionTasker": "Configurazione di Tasker",
  "autoGuideSectionIos": "Scorciatoie iOS e Siri",
  "autoGuideSectionUrlScheme": "Riferimento dello schema URL",
  "autoGuideSectionBatch": "Esecuzione in batch",
  "autoGuideSectionSnippetVars": "Variabili degli snippet",
  "autoGuideSectionOutputFilters": "Filtri di output",

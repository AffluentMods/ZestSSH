  "autoGuideTitle": "Automation गाइड",
  "autoGuideReferenceTitle": "Automation संदर्भ",
  "autoGuideIntro": "बाहरी ऐप्स, शॉर्टकट्स, और निर्धारित कार्यों से SSH कमांड ट्रिगर करने के लिए आवश्यक सब कुछ।",
  "autoGuideSectionWhatIs": "Automation क्या है?",
  "autoGuideSectionMacroDroid": "MacroDroid सेटअप",
  "autoGuideSectionTasker": "Tasker सेटअप",

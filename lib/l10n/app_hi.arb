  "connectionEditAuthSftpOnly": "इस होस्ट के लिए कुंजी या पासवर्ड बेसिक के अंतर्गत चुनें। साइन इन SSH की तरह होता है। एजेंट फ़ॉरवर्डिंग लागू नहीं होती: केवल SFTP वाला होस्ट टर्मिनल नहीं देता।",
  "connectionTestSftpWorks": "कनेक्ट हो गया: TCP {tcpMs}ms, पूर्ण हैंडशेक {totalMs}ms। SFTP काम करता है (इसका पहला फ़ोल्डर सूचीबद्ध हुआ), और यह होस्ट टर्मिनल नहीं देता।{jumpNote}",
  "sessionFilesOnlyLine": "यह सत्र केवल फ़ाइलों के लिए है (SFTP): इसमें टर्मिनल नहीं है।",
  "sessionFilesOnlyLineFtps": "यह सत्र केवल फ़ाइलों के लिए है (FTPS): इसमें टर्मिनल नहीं है।",
  "hostSftpOnlyNoTerminal": "यह होस्ट केवल SFTP है: यह टर्मिनल नहीं देता।",
  "hostNoCommandsNotSsh": "यह होस्ट SSH से नहीं जुड़ता, इसलिए वर्कफ़्लो या टास्क इस पर कमांड नहीं चला सकता।",
  "filesOnlyWatched": "इस होस्ट के सत्रों की निगरानी इसकी टीम करती है, और निगरानी वाला सत्र होस्ट की फ़ाइलों तक पहुँच नहीं देता, इसलिए उन्हें यहाँ नहीं खोला जा सकता।",
  "sftpOnlyRefusalTitle": "यह होस्ट केवल फ़ाइलें देता है",
  "sftpOnlyRefusalSaid": "{host} केवल SFTP की अनुमति देता है: यह टर्मिनल नहीं देता। इसके बजाय इसकी फ़ाइलें खोलें, या इसे केवल SFTP बना दें ताकि अब से यह इसी तरह खुले।",
  "sftpOnlyRefusalAtOnce": "{host} ने टर्मिनल खुलते ही बंद कर दिया। अगर यह केवल SFTP की अनुमति देता है, तो इसकी फ़ाइलें फिर भी खोली जा सकती हैं, और इसे केवल SFTP बनाया जा सकता है ताकि अब से यह इसी तरह खुले।",
  "sftpOnlyOpenFiles": "इसकी फ़ाइलें खोलें",
  "sftpOnlyMakeHost": "इस होस्ट को केवल SFTP बनाएँ",
  "sftpOnlyMakeNotAllowed": "यह होस्ट यहाँ बदला नहीं जा सका: यह अब सहेजा हुआ नहीं है, या इसका वॉल्ट आपको इसे संपादित करने नहीं देता। इसकी फ़ाइलें फिर भी खोली जा सकती हैं।",
  "sftpOnlyTurnedBack": "ZestSSH के पुराने संस्करण वाले आपके एक डिवाइस ने इस होस्ट को वापस SSH बना दिया। उस डिवाइस को अपडेट करें, नहीं तो वह फिर ऐसा करेगा।",
  "authenticatorTitle": "ऑथेंटिकेटर ऐप",
  "authenticatorOnDesc": "साइन इन करते समय आप अपने ऑथेंटिकेटर ऐप का 6 अंकों का कोड इस्तेमाल कर सकते हैं।",
  "authenticatorOffDesc": "साइन इन करते समय Google Authenticator, Microsoft Authenticator, 1Password या Bitwarden जैसे किसी ऐप का 6 अंकों का कोड।",
  "authenticatorWebDesc": "साइन इन करते समय किसी ऑथेंटिकेटर ऐप का 6 अंकों का कोड। इसे zestssh.com पर सेट अप करें: यह हर डिवाइस पर काम करता है।",
  "authenticatorSetupIntro": "इसके बाद साइन इन करते समय आप किसी ऑथेंटिकेटर ऐप, जैसे Google Authenticator, Microsoft Authenticator, 1Password या Bitwarden, का कोड भी इस्तेमाल कर सकेंगे। पहले, यह पुष्टि करने के लिए फिर से साइन इन करें कि यह आप ही हैं।",
  "authenticatorOn": "आपका ऑथेंटिकेटर ऐप सेट अप हो गया है।",
  "authenticatorRemove": "हटाएँ",
  "authenticatorRemoveTitle": "अपना ऑथेंटिकेटर ऐप हटाएँ?",
  "authenticatorRemoveBody": "इससे दूसरा चरण अब पूरा नहीं होगा, और आपके दूसरे डिवाइस साइन आउट हो जाएँगे।",
  "authenticatorRemoveLastBody": "आपका ऑथेंटिकेटर ऐप आपके खाते के दूसरे चरण का एकमात्र तरीका है: इसे हटाने से दो-चरणीय साइन-इन बंद हो जाता है, और आपके बैकअप कोड काम करना बंद कर देते हैं।",
  "authenticatorRemoved": "आपका ऑथेंटिकेटर ऐप हटा दिया गया है।",
  "authenticatorRemovedOff": "आपका ऑथेंटिकेटर ऐप हटा दिया गया, और उसके साथ दो-चरणीय साइन-इन भी बंद हो गया: आपके बैकअप कोड अब काम नहीं करते।",
  "handoffExpired": "इस साइन-इन को ZestSSH तक पहुँचने में दो मिनट से ज़्यादा लग गए। फिर से कोशिश करें।",
  "handoffWrongAccount": "ब्राउज़र में किसी दूसरे खाते से साइन इन हुआ। फिर से कोशिश करें, और वहाँ उसी खाते से साइन इन करें जिससे यहाँ साइन इन है।",
  "lockoutTitle": "अपना खाता रिकवर करें",
  "lockoutIntro": "इसका इस्तेमाल तब करें, जब आपने दूसरे चरण के सभी तरीके (आपकी पासकी या आपका ऑथेंटिकेटर ऐप) और सभी बैकअप कोड खो दिए हों। ZestSSH आपके ईमेल पते पर एक कोड भेजता है। उसे डालने के बाद रिकवरी सात दिन रुकती है, और आपके खाते में साइन इन हर डिवाइस को इसकी सूचना दी जाती है, जहाँ से इसे रद्द किया जा सकता है। इसके बाद दो-चरणीय साइन-इन बंद किया जा सकता है।",
  "lockoutSendCode": "कोड भेजें",
  "lockoutCodeSent": "अगर {email} का ऐसा खाता है जिसे इस तरह रिकवर किया जा सकता है, तो वहाँ एक कोड भेजा जा रहा है। उसे यहाँ डालें। यह आधे घंटे तक काम करता है।",
  "lockoutResetCodeSent": "खाता रीसेट करने के लिए दिखाएँ कि {email} अब भी आपका है: उस पते पर एक कोड भेजा जा रहा है। उसे यहाँ डालें, और रीसेट आगे बढ़ेगा।",
  "lockoutCodeLabel": "ईमेल में आया कोड",
  "lockoutConfirm": "रिकवरी शुरू करें",
  "lockoutAskAgain": "नया कोड भेजें",
  "lockoutCodeInvalid": "यह कोड काम नहीं किया, या इसकी अवधि खत्म हो गई। इसे जाँचें, या नया कोड भेजें।",
  "lockoutWaitingSelfTitle": "आपकी रिकवरी प्रतीक्षा में है",
  "lockoutWaitingSelfBody": "{email} की रिकवरी {date} तक रुकी रहेगी। उसके बाद आप इसे यहाँ पूरा कर सकते हैं। तब तक खाते में साइन इन कोई भी डिवाइस इसे रद्द कर सकता है, और ZestSSH एक दिन पहले उस पते पर फिर से ईमेल भेजता है।",
  "lockoutForget": "यह रिकवरी भूल जाएँ",
  "lockoutForgetTitle": "इस डिवाइस पर यह रिकवरी भूल जाएँ?",
  "lockoutForgetBody": "यह डिवाइस इसकी प्रतीक्षा करना बंद कर देता है। रिकवरी खुद अपनी अवधि खत्म होने तक बनी रहती है, अगर खाते में साइन इन कोई डिवाइस उसे पहले रद्द न कर दे। आप नई रिकवरी मांग सकते हैं।",
  "lockoutDueTitle": "अपनी रिकवरी पूरी करें",
  "lockoutDueBodyProof": "अपना सिंक किया गया डेटा रखने के लिए {email} का सिंक पासवर्ड दर्ज करें। फिर दो-चरणीय साइन-इन बंद हो जाता है, हर डिवाइस साइन आउट हो जाता है, और आप अपने पासवर्ड, Google, Apple, Microsoft या अपनी कंपनी के साइन-इन से साइन इन करते हैं।",
  "lockoutSyncPasswordLabel": "सिंक पासवर्ड",
  "lockoutKeepData": "मेरा डेटा रखें",
  "lockoutResetInstead": "मुझे अपना सिंक पासवर्ड नहीं पता: खाता रीसेट करें",
  "lockoutResetTitle": "अपना खाता रीसेट करें?",
  "lockoutResetBody": "सिंक पासवर्ड के बिना रिकवरी आपके खाते को रीसेट कर देती है। दो-चरणीय साइन-इन बंद हो जाता है, और साथ ही:",
  "lockoutNoProofBody": "आपके खाते में रखने के लिए कोई सिंक किया गया डेटा नहीं है, या उसके लिए कोई रिकवरी प्रमाण सहेजा नहीं गया, इसलिए रिकवरी उसे रीसेट कर देती है। दो-चरणीय साइन-इन बंद हो जाता है, और साथ ही:",
  "lockoutResetLosesData": "आपका सिंक किया गया डेटा ऐसी जगह अलग रख दिया जाता है जहाँ उसे कुछ भी नहीं पढ़ता, और 30 दिन बाद हटा दिया जाता है।",
  "lockoutResetLosesTeams": "आपकी टीमों में आपकी कुंजियाँ हटा दी जाती हैं, और हर टीम के मालिकों और एडमिन को बताया जाता है: वहाँ से कोई आपको फिर से पहुँच देता है।",
  "lockoutResetLosesDevices": "हर डिवाइस साइन आउट हो जाता है, और हर एक को फिर से स्वीकृत करना होता है।",
  "lockoutResetKeeps": "आपके डिवाइसों पर जो है, वह बना रहता है: उन पर मौजूद होस्ट और कुंजियों को छुआ नहीं जाता।",
  "lockoutResetConfirm": "रीसेट और रिकवर करें",
  "lockoutCannotProveHere": "इस डिवाइस पर इस खाते में सिंक के साथ कभी साइन इन नहीं किया गया, इसलिए यह आपका सिंक पासवर्ड साबित नहीं कर सकता। अपना डेटा रखने के लिए रिकवरी किसी ऐसे डिवाइस पर पूरी करें जिस पर ऐसा किया गया था, या यहाँ खाता रीसेट करें।",
  "lockoutProofInvalid": "{count, plural, =0{इस सिंक पासवर्ड से खाते की पुष्टि नहीं हुई, और इसे फिर से नहीं आज़माया जा सकता: अब केवल रीसेट बचा है।} one{इस सिंक पासवर्ड से खाते की पुष्टि नहीं हुई। {count} और कोशिश बाकी है, उसके बाद केवल रीसेट बचेगा।} other{इस सिंक पासवर्ड से खाते की पुष्टि नहीं हुई। {count} और कोशिशें बाकी हैं।}}",
  "lockoutProofClosed": "इस रिकवरी के लिए सिंक पासवर्ड बहुत बार आज़माया जा चुका है। आप अब भी इसके बिना आगे बढ़ सकते हैं, जिससे खाता रीसेट हो जाता है।",
  "lockoutNotYet": "रिकवरी अभी पूरी नहीं की जा सकती: यह {date} तक रुकी है।",
  "lockoutNotYetNoDate": "रिकवरी अभी पूरी नहीं की जा सकती: यह अनुरोध के समय से सात दिन तक रुकती है।",
  "lockoutTicketInvalid": "यह रिकवरी अब प्रतीक्षा में नहीं है: इसे खाते में साइन इन किसी डिवाइस से रद्द किया गया, इसकी अवधि खत्म हो गई, या इसे कहीं और से फिर से मांगा गया। अगर आपको अब भी इसकी ज़रूरत है, तो फिर से अनुरोध करें।",
  "lockoutThroughCompany": "यह खाता आपकी कंपनी के ज़रिए साइन इन करता है, और उसकी साइन-इन सेवा ही इसे रिकवर करती है। अपनी IT टीम से पूछें।",
  "lockoutDone": "आपके खाते के लिए दो-चरणीय साइन-इन बंद है, और आपका डेटा रखा गया है। अपने पासवर्ड, Google, Apple, Microsoft या अपनी कंपनी के साइन-इन से साइन इन करें।",
  "lockoutDoneReset": "आपका खाता रिकवर और रीसेट कर दिया गया है: दो-चरणीय साइन-इन बंद है। अपने पासवर्ड, Google, Apple, Microsoft या अपनी कंपनी के साइन-इन से साइन इन करें, फिर सिंक दोबारा सेट अप करें।",
  "lockoutLink": "दो-चरणीय साइन-इन पूरा नहीं कर पा रहे? अपना खाता रिकवर करें",
  "lockoutLinkDesc": "तब के लिए, जब आपकी पासकी या आपका ऑथेंटिकेटर ऐप, और सभी बैकअप कोड खो गए हों।",
  "lockoutStart": "रिकवर करें",
  "lockoutHereDesc": "इस डिवाइस से मांगी गई रिकवरी। इसे {date} से पूरा किया जा सकता है।",
  "lockoutWaitingTitle": "किसी ने आपका खाता रिकवर करने का अनुरोध किया है",
  "lockoutWaitingBody": "{asked} को किसी ने {email} को रिकवर करने का अनुरोध किया, क्योंकि उसके दूसरे चरण का तरीका खो गया था। अगर आप इसे रद्द नहीं करते, तो {completes} से वह व्यक्ति दो-चरणीय साइन-इन बंद कर सकता है: सिंक पासवर्ड के साथ डेटा बना रहता है, उसके बिना खाता रीसेट हो जाता है। अगर यह आप ही थे, तो कुछ करने की ज़रूरत नहीं है।",
  "lockoutWaitingBodyNoDate": "किसी ने {email} को रिकवर करने का अनुरोध किया, क्योंकि उसके दूसरे चरण का तरीका खो गया था। अगर आप इसे रद्द नहीं करते, तो {completes} से वह व्यक्ति दो-चरणीय साइन-इन बंद कर सकता है: सिंक पासवर्ड के साथ डेटा बना रहता है, उसके बिना खाता रीसेट हो जाता है। अगर यह आप ही थे, तो कुछ करने की ज़रूरत नहीं है।",
  "lockoutNotMe": "यह मैंने नहीं किया",

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the app shares with its widget (Runner.entitlements):
	     the widget reads the hosts the app gives it from here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ZEST_APP_GROUP)</string>
	</array>
</dict>
</plist>

# Build settings of ZestSSH: every name the app reads at compile time
# (String.fromEnvironment and bool.fromEnvironment in lib/).
#
# Copy this file to .env (ignored by git) and pass it to a build or a run:
#   flutter run --dart-define-from-file=.env
# or give single settings: --dart-define=ZEST_ORCHARDS=true
#
# Every line here is a comment: copied as it is, the file sets nothing and every
# setting keeps its default. Remove the "# " of a line to set it. A name set to an
# empty value is set to "", which is NOT its default: leave a line commented out
# rather than empty.
#
# NEVER put a secret here. Each value is compiled into the app as readable text
# that anyone with the binary can extract. The values below are placeholders.
#
# test/docs/open_source_tree_test.dart checks that this file names every name
# lib/ reads.

# ---- The service a build talks to ----
# Default: the official ZestSSH service (lib/config/official_identity.dart holds every
# official address). A build you give to others must not use it; point these at a server
# of your own (docs/self-hosted-sync.md).
# SYNC_API_BASE_URL=https://api.example.org/v1
# Default: SYNC_API_BASE_URL + /entitlements.
# ENTITLEMENTS_API_URL=https://api.example.org/v1/entitlements
# The computer's sign-in page, opened in the browser. It must already hold a "?".
# AUTH_URL=https://example.org/auth?platform=desktop
# The website: every website page moves with it (privacy, terms, download, account
# security, browser sign-in, upgrade checkout, the plans and Teams seats pages, and the
# passkey origin's default).
# WEBSITE_URL=https://example.org
# The API's host as error pages name it (default api.zestssh.com).
# ZEST_API_HOST=api.example.org
# The user guides, with no slash at the end (default https://docs.zestssh.com).
# ZEST_DOCS_URL=https://docs.example.org
# The docs site's host as error pages name it (default docs.zestssh.com).
# ZEST_DOCS_HOST=docs.example.org
# What a team's join link starts with (default https://zestssh.com/join). Its own setting on
# purpose: the links a phone opens in the app are the ones registered when it was installed.
# ZEST_JOIN_LINK_BASE=https://example.org/join
# The support address (default support@zestssh.com).
# ZEST_SUPPORT_EMAIL=support@example.org
# The community chat's invite link (default the official Discord invite).
# ZEST_DISCORD_URL=https://example.org/chat
# The maker's site, linked from About and Help (default the official one).
# ZEST_MAKER_URL=https://example.org

# ---- Updates and store pages ----
# The host the in-app updater reads its signed manifest and downloads from (default the
# official website's).
# ZEST_UPDATE_HOST=example.org
# The public keys (base64 Ed25519) the update manifest must be signed with: the release's
# key by default, the second one empty. A build with no key takes no update at all.
# ZEST_UPDATE_KEY=placeholder-base64-ed25519-public-key
# ZEST_UPDATE_KEY_2=placeholder-base64-ed25519-public-key
# The App Store id and the Google Play package the review links open (default the official
# listings'). Here an empty value is meant: the row is not shown and no review is asked for.
# ZEST_APP_STORE_ID=placeholder
# ZEST_PLAY_PACKAGE=org.example.placeholder

# ---- Official or community build ----
# true only for the official builds. A build of your own leaves it unset: without it every
# official address is empty and the features that need them are absent (BUILDING.md).
# ZEST_OFFICIAL=false
# The name the build gives itself (in reports and on the About page).
# ZEST_BUILD_NAME=placeholder-community-build

# ---- Passkeys on Windows ----
# The relying party id and origin passkeys are made for (default: the official site's).
# ZEST_PASSKEY_RP_ID=example.org
# ZEST_PASSKEY_ORIGIN=https://example.org

# ---- Google Drive sync and backup on Windows, macOS and Linux ----
# An OAuth client of type "Desktop app" in your own Google Cloud project. Google
# documents that a desktop client's secret is not confidential. Default: empty,
# and Google Drive is not offered on computers.
# GOOGLE_DESKTOP_CLIENT_ID=000000000000-placeholder.apps.googleusercontent.com
# GOOGLE_DESKTOP_CLIENT_SECRET=placeholder

# ---- In-app purchases on phones ----
# The public SDK keys of your own RevenueCat project. Default: empty, purchases
# are off and the app runs as Free.
# REVENUECAT_ANDROID_KEY=goog_placeholder
# REVENUECAT_IOS_KEY=appl_placeholder

# ---- Switches: true or false, all false by default ----
# Teams (called Orchards in the code). The tests are run with it on.
# ZEST_ORCHARDS=true
# A development build made to try the RD Gateway for RDP hosts (4.0); an official
# build (ZEST_OFFICIAL=true) ignores it.
# ZEST_RDP_GATEWAY=false
# A "Continue with Microsoft" button on the sign-in screen.
# ZEST_MICROSOFT=false
# The system's own window frame on computers, in place of the app's.
# ZEST_NATIVE_FRAME=false
# Experimental: the SSH connection in a worker isolate. Leave it off.
# WORKER_CONN_ISOLATION=false
# Debug builds only: fills an empty install with the made-up demo hosts of the
# screenshot tests on its first start. Ignored by release and profile builds.
# ZEST_DEMO_SEED=false

# ---- For the official builds only: do not set these in a build of your own ----
# The Microsoft Store package (turns off the app's own update check).
# ZEST_STORE=false
# Where the updater reads its manifest, for tests of the official updater.
# ZEST_UPDATE_MANIFEST_URL=https://example.org/latest.json

; ZestSSH Windows Installer - Inno Setup Script
; Build with: iscc zestssh_setup.iss
;
; Branded wizard art is generated by generate_wizard_images.ps1 into
; images\  (version-agnostic; only regenerate after a logo change).
;
; SECURITY: This installer is NOT code-signed. Before public distribution,
; sign the output .exe with a trusted code signing certificate using SignTool:
;   signtool sign /fd SHA256 /tr http://timestamp.digicert.com /td SHA256 ^
;     /f certificate.pfx /p <password> dist\ZestSSH-X.Y.Z-Setup.exe
; Without signing, Windows SmartScreen will warn users on download/launch.

#define MyAppName "ZestSSH"
#define MyAppVersion "3.4.2"
#define MyAppPublisher "Affluent Labs"
#define MyAppURL "https://zestssh.com"
#define MyAppExeName "zestssh.exe"
; The Store package (lib/services/store_handover.dart): its name, its family name, and what starts it.
#define StorePackageName "AffluentLabs.ZestSSH"
#define StorePackageFamily "AffluentLabs.ZestSSH_a13075jvne08e"
#define StoreAppsFolderTarget "shell:AppsFolder\" + StorePackageFamily + "!zestssh"
#define BuildDir "..\build\windows\x64\runner\Release"

; The app needs the Visual C++ runtime, and Windows does not ship it: the
; build puts these next to zestssh.exe (windows\CMakeLists.txt) and the
; [Files] section below takes every DLL from there. An installer built from
; a folder without them would install an app that does not start on a PC
; that never had the runtime, so it is not built at all.
#define RuntimeDir AddBackslash(SourcePath) + BuildDir + "\"
#if !FileExists(RuntimeDir + "msvcp140.dll") || !FileExists(RuntimeDir + "vcruntime140.dll") || !FileExists(RuntimeDir + "vcruntime140_1.dll")
  #error The Visual C++ runtime DLLs (msvcp140.dll, vcruntime140.dll, vcruntime140_1.dll) are not in the build folder. Run "flutter build windows --release" again; windows\CMakeLists.txt copies them there.
#endif

[Setup]
AppId={{F47AC10B-58CC-4372-A567-0E02B2C3D479}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
; DisableDirPage defaults to "auto": FRESH installs show the directory page
; (new customers choose their location), while UPGRADES silently reuse the
; existing folder: the streamlined path we want for the common case.
; The Ready page confirmed a single checkbox and showed nothing the user
; hadn't just picked - removed so there are fewer screens between download and
; first launch. Back from the install/finish flow still reaches prior pages.
DisableReadyPage=yes
OutputDir=..\dist
OutputBaseFilename=ZestSSH-{#MyAppVersion}-Setup
SetupIconFile=..\assets\app_icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
WizardSizePercent=120,120
; Branded sidebar + header art (generated by generate_wizard_images.ps1)
WizardImageFile=images\wizard_image.bmp
WizardSmallImageFile=images\wizard_small_image.bmp
WizardImageStretch=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName} {#MyAppVersion}
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
; "Add to PATH" edits the per-user Environment; broadcast the change so
; already-open shells/Explorer pick it up without a reboot.
ChangesEnvironment=yes
; Detect a running ZestSSH and offer to close it before install
; (avoids the "files in use" failure).
CloseApplications=force
CloseApplicationsFilter=*.exe,*.dll
RestartApplications=no
; Branding
AppCopyright=© 2026 Affluent Labs LLC. All rights reserved.
VersionInfoVersion={#MyAppVersion}.0
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=ZestSSH: The Fresh SSH Client
VersionInfoProductName={#MyAppName}
LicenseFile=eula.txt

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
WelcomeLabel1=Welcome to ZestSSH
WelcomeLabel2=A modern SSH client for servers, SFTP, port forwarding, and automation, with a fast terminal, cloud sync, and a workflow builder.%n%nThis will install [name/ver] on your computer.
ClickNext=Click Next to continue, or Cancel to exit.
FinishedHeadingLabel=You're all set
FinishedLabelNoIcons=ZestSSH {#MyAppVersion} is installed and ready.
FinishedLabel=ZestSSH {#MyAppVersion} is installed and ready. Launch it to connect your first server.
SelectDirLabel3=Setup will install [name] into the following folder.
SelectDirBrowseLabel=To continue, click Next. To pick a different folder, click Browse.
ReadyLabel1=Setup is ready to install ZestSSH on your computer.
ReadyLabel2a=Review your choices below, then click Install to continue.

[Tasks]
; ── Shortcuts ──────────────────────────────────────────────────────
Name: "startmenuicon"; Description: "Start Menu shortcut"; GroupDescription: "Shortcuts:"
Name: "desktopicon"; Description: "Desktop shortcut"; GroupDescription: "Shortcuts:"; Flags: unchecked
; ── Integration ────────────────────────────────────────────────────
Name: "addtopath"; Description: "Add ZestSSH to PATH: run ""zestssh"" from any terminal"; GroupDescription: "Integration:"; Flags: unchecked
Name: "launchonstartup"; Description: "Launch ZestSSH automatically when Windows starts"; GroupDescription: "Integration:"; Flags: unchecked

[Files]
Source: "{#BuildDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#BuildDir}\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#BuildDir}\data\*"; DestDir: "{app}\data"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Comment: "The Fresh SSH Client"
Name: "{group}\Uninstall {#MyAppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Comment: "The Fresh SSH Client"; Tasks: desktopicon
Name: "{userstartup}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: launchonstartup

[Registry]
; Register zestssh:// URL protocol for OAuth callback and automation deep links
Root: HKCU; Subkey: "Software\Classes\zestssh"; ValueType: string; ValueName: ""; ValueData: "ZestSSH"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\zestssh"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\zestssh\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\zestssh\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey
; Add the install dir to the per-user PATH (safe append - Check prevents
; duplicates on reinstall). Uninstall removal is handled in [Code].
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"; Tasks: addtopath; Check: NeedsAddPath('{app}')
; What Windows' notifications know ZestSSH by (4.0, Settings > Notifications >
; Also show as system notifications): the app writes these itself the first
; time that is turned on (NotificationService.windowsAppUserModelId); they go
; with ZestSSH when it is uninstalled, and are never made here.
Root: HKCU; Subkey: "Software\Classes\AppUserModelId\AffluentLabs.ZestSSH"; Flags: uninsdeletekey dontcreatekey
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\PushNotifications\Backup\AffluentLabs.ZestSSH"; Flags: uninsdeletekey dontcreatekey

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Launch ZestSSH"; Flags: nowait postinstall skipifsilent
; The app's own "Update and restart" (lib/services/app_updater.dart) runs this
; setup with /VERYSILENT ... /FROMAPP /RELAUNCH: after a silent update, open the
; new version again, as the person who started the update (never elevated).
; "Update and close" leaves /RELAUNCH out, and so does a silent install by a
; script or winget: those open nothing.
Filename: "{app}\{#MyAppExeName}"; Flags: nowait runasoriginaluser; Check: IsUpdateRelaunch
Filename: "{#MyAppURL}"; Description: "See what's new in {#MyAppVersion}"; Flags: postinstall shellexec skipifsilent unchecked

[UninstallDelete]
Type: dirifempty; Name: "{app}"

[Code]

// Interior-page controls created in InitializeWizard (the tasks hint, the accent rail).
var
  TasksHint: TNewStaticText;
  AccentRail: TPanel;

// Whether [Name] is one of this setup's parameters.
function HasParam(Name: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount do
    if CompareText(ParamStr(I), Name) = 0 then
      Result := True;
end;

// True when the app's own update started this setup: it passes /FROMAPP
// (3.3.0 on, with /VERYSILENT), see lib/services/app_updater.dart. Before
// 3.3.0 it passed /RELAUNCH alone, which still says the same.
function UpdateRequested(): Boolean;
begin
  Result := HasParam('/FROMAPP') or HasParam('/RELAUNCH');
end;

// The [Run] entry that opens the app again after a silent update: Update and
// restart passes /RELAUNCH, Update and close does not.
function IsUpdateRelaunch(): Boolean;
begin
  Result := WizardSilent and HasParam('/RELAUNCH');
end;

// Whether ZestSSH from the Microsoft Store is installed for this Windows
// account: Windows keeps a folder for each installed package (the family name
// as lib/services/store_handover.dart names it).
function StoreCopyInstalled(): Boolean;
begin
  Result := DirExists(ExpandConstant('{localappdata}\Packages\{#StorePackageFamily}'));
end;

// The Store copy's version against this setup's,
// the rule the website copy keeps at its start
// (lib/services/store_handover_version.dart): the Store copy is opened instead
// of installing only where it is at least this version. This setup can be a
// release ahead of the Store's (on zestssh.com before the Store has it), and a
// Store copy older than the data on this PC may not read it (3.3's per-account
// profiles, for a 3.2.7). Windows PowerShell's Get-AppxPackage answers by its
// exit code: 10, at least this version; 11, older; 12, no such package for
// this Windows account (a folder left behind). Anything else: it could not
// tell, and this setup installs as usual, the safe side (the copy it installs
// looks again at its start, and goes to the Store copy where that is new
// enough). [version] compares as numbers (3.10 after 3.9), and the package's
// 3.3.0.0 is at least this setup's 3.3.0.
const
  StoreCopyAtLeastThis = 10;
  StoreCopyOlder = 11;
  StoreCopyNone = 12;

function StoreCopyAgainstThisVersion(): Integer;
var
  ResultCode: Integer;
begin
  if Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
       '-NoProfile -NonInteractive -Command "$p = @(Get-AppxPackage -Name {#StorePackageName} -ErrorAction Stop | Where-Object PackageFamilyName -eq {#StorePackageFamily}); if ($p.Count -eq 0) { exit 12 }; $v = [version[]]$p.Version | Sort-Object -Descending | Select-Object -First 1; if ($v -ge [version]''{#MyAppVersion}'') { exit 10 } else { exit 11 }"',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Result := ResultCode
  else
    Result := -1;
end;

// Whether a zestssh.exe is running: tasklist names it, and find answers 0
// only where it found the name.
function AppIsRunning(): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'),
       '/c tasklist /FI "IMAGENAME eq {#MyAppExeName}" /NH | find /I "{#MyAppExeName}" >nul',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

// True when the app stopped waiting for this update: it found no log within
// two minutes (Windows had not allowed this setup: its UAC prompt was up, or
// answered late) and stayed open. It leaves "<the /LOG file>.cancelled"
// (windowsCancelMarkerFor, lib/services/app_updater.dart); this setup then
// installs nothing and closes nothing. The log exists before this is first
// read (Inno opens it before InitializeSetup), and the app gives up only while
// there is no log, so the two never both go ahead.
function UpdateCancelledByApp(): Boolean;
var
  I: Integer;
  P: String;
begin
  Result := False;
  for I := 1 to ParamCount do
  begin
    P := ParamStr(I);
    if CompareText(Copy(P, 1, 5), '/LOG=') = 0 then
      Result := FileExists(Copy(P, 6, Length(P) - 5) + '.cancelled');
  end;
end;

// Belt-and-suspenders to CloseApplications=force: kill any stragglers
// (orphaned terminal subprocesses, shell helpers) before we touch files.
//
// An update the app started: the app is quitting by itself (saving its tabs,
// ending its sessions) as this starts, so it is given up to 30 seconds to be
// gone before anything is killed. And then without /T: this setup is a child
// of that zestssh.exe, and /T would end the setup itself with it.
function InitializeSetup(): Boolean;
var
  ResultCode: Integer;
  Waited: Integer;
  StoreCopy: Integer;
begin
  // One ZestSSH per PC, the Store's preferred:
  // where ZestSSH from the Microsoft Store is installed for this
  // Windows account, it is opened instead of a second copy being installed. An
  // update the website copy started itself (/FROMAPP) goes on: that copy hands
  // its data over and opens the Store's at its next start (store_handover.dart).
  // Only a Store copy at least as new as this setup is opened
  // (StoreCopyAgainstThisVersion).
  // A silent install (winget, a script) installs as usual: it opened the Store
  // app and ended with exit code 1, which winget reports as a failure; the
  // copy it installs goes to the Store copy at its first start.
  if (not UpdateRequested()) and (not WizardSilent) and StoreCopyInstalled() then
  begin
    StoreCopy := StoreCopyAgainstThisVersion();
    if StoreCopy = StoreCopyAtLeastThis then
    begin
      Exec(ExpandConstant('{win}\explorer.exe'), '{#StoreAppsFolderTarget}', '', SW_SHOWNORMAL, ewNoWait, ResultCode);
      Log('ZestSSH from the Microsoft Store is on this PC: it was opened, and nothing is installed.');
      MsgBox('ZestSSH from the Microsoft Store is already on this PC, and it keeps itself up to date. It has been opened for you: nothing was installed.', mbInformation, MB_OK);
      Result := False;
      exit;
    end
    else if StoreCopy = StoreCopyOlder then
      Log('ZestSSH from the Microsoft Store on this PC is older than {#MyAppVersion}: it is not opened, and this setup installs as usual. The copy it installs goes to the Store copy once the Store has updated it.')
    else if StoreCopy = StoreCopyNone then
      Log('A folder of ZestSSH from the Microsoft Store is on this PC, but no such package for this Windows account: this setup installs as usual.')
    else
      Log(Format('The version of ZestSSH from the Microsoft Store could not be read (%d): this setup installs as usual, the safe side.', [StoreCopy]));
  end;
  if UpdateRequested() then
  begin
    Waited := 0;
    while AppIsRunning() and (Waited < 120) and not UpdateCancelledByApp() do
    begin
      Sleep(250);
      Waited := Waited + 1;
    end;
    if UpdateCancelledByApp() then
    begin
      Log('ZestSSH stopped waiting for this update and stayed open: nothing is installed.');
      Result := False;
      exit;
    end;
    Exec(ExpandConstant('{cmd}'),
         '/c taskkill /F /IM {#MyAppExeName} >nul 2>&1',
         '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end
  else
    Exec(ExpandConstant('{cmd}'),
         '/c taskkill /F /IM {#MyAppExeName} /T >nul 2>&1',
         '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Sleep(400);
  Result := True;
end;

// True when {app} is not already on the per-user PATH - prevents adding
// a duplicate entry on reinstall.
function NeedsAddPath(Param: string): Boolean;
var
  OrigPath: string;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath) then
  begin
    Result := True;
    exit;
  end;
  Result := Pos(';' + Uppercase(Param) + ';', ';' + Uppercase(OrigPath) + ';') = 0;
end;

// Remove ONLY our own entry from the per-user PATH on uninstall - never
// touch the rest of the value.
procedure RemoveFromPath(AppDir: string);
var
  OrigPath: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath) then
    exit;
  P := Pos(';' + Uppercase(AppDir) + ';', ';' + Uppercase(OrigPath) + ';');
  if P = 0 then exit;
  // P indexes into ';'+OrigPath+';'. When our dir is the FIRST entry P=1,
  // so P-1=0 and Delete(...,0,...) is a silent no-op - handle it: delete
  // "AppDir;" from the front. Otherwise delete ";AppDir" starting at P-1.
  if P = 1 then
    Delete(OrigPath, 1, Length(AppDir) + 1)
  else
    Delete(OrigPath, P - 1, Length(AppDir) + 1);
  RegWriteExpandStringValue(HKEY_CURRENT_USER, 'Environment', 'Path', OrigPath);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    RemoveFromPath(ExpandConstant('{app}'));
end;

// Dark, on-brand styling for the modern wizard.
procedure LicenseAcceptClick(Sender: TObject);
begin
  WizardForm.LicenseAcceptedRadio.Checked := True;
end;

procedure LicenseDeclineClick(Sender: TObject);
begin
  WizardForm.LicenseNotAcceptedRadio.Checked := True;
end;

{ Themed Windows draws a radio button's caption text in its own dark colour and
  ignores Font.Color, so on the dark wizard the accept/decline choices were
  unreadable. Blank the native caption and return a light static label beside the
  circle; the caller wires OnClick to select the radio so the label stays
  clickable. }
function LightRadioLabel(Radio: TRadioButton): TNewStaticText;
begin
  Result := TNewStaticText.Create(WizardForm);
  Result.Parent := Radio.Parent;
  Result.Caption := Radio.Caption;
  Result.Left := Radio.Left + ScaleX(22);
  Result.Top := Radio.Top + ScaleY(1);
  Result.AutoSize := True;
  Result.Font.Color := $00E0E0E0;
  Radio.Caption := '';
end;

procedure InitializeWizard();
var
  LicensePanel: TWinControl;
  I: Integer;
  AcceptLbl, DeclineLbl: TNewStaticText;
begin
  // Surfaces
  WizardForm.Color := $000A0A0A;
  WizardForm.MainPanel.Color := $00111111;
  WizardForm.InnerPage.Color := $000A0A0A;
  WizardForm.WelcomePage.Color := $000A0A0A;
  WizardForm.FinishedPage.Color := $000A0A0A;
  WizardForm.Bevel.Visible := False;

  // Header labels (page name is orange; description is muted)
  WizardForm.PageNameLabel.Font.Color := $000A60E8; // #E8600A in BGR
  WizardForm.PageNameLabel.Font.Size := 12;
  WizardForm.PageNameLabel.Font.Style := [fsBold];
  WizardForm.PageDescriptionLabel.Font.Color := $00B0B0B0;

  // Welcome / Finished headings
  WizardForm.WelcomeLabel1.Font.Color := $000A60E8;
  WizardForm.WelcomeLabel1.Font.Size := 22;
  WizardForm.WelcomeLabel1.Font.Style := [fsBold];
  WizardForm.WelcomeLabel2.Font.Color := $00E0E0E0;
  WizardForm.FinishedHeadingLabel.Font.Color := $000A60E8;
  WizardForm.FinishedHeadingLabel.Font.Size := 22;
  WizardForm.FinishedHeadingLabel.Font.Style := [fsBold];
  WizardForm.FinishedLabel.Font.Color := $00E0E0E0;

  // Directory page
  WizardForm.SelectDirLabel.Font.Color := $00E0E0E0;
  WizardForm.SelectDirBrowseLabel.Font.Color := $00B0B0B0;
  WizardForm.DirEdit.Color := $001A1A1A;
  WizardForm.DirEdit.Font.Color := $00E0E0E0;
  WizardForm.DiskSpaceLabel.Font.Color := $00B0B0B0;

  // Tasks list
  WizardForm.SelectTasksLabel.Font.Color := $00E0E0E0;
  WizardForm.TasksList.Color := $00111111;
  WizardForm.TasksList.Font.Color := $00E0E0E0;

  // Ready page memo
  WizardForm.ReadyLabel.Font.Color := $00E0E0E0;
  WizardForm.ReadyMemo.Color := $00111111;
  WizardForm.ReadyMemo.Font.Color := $00E0E0E0;

  // Install / progress page
  WizardForm.StatusLabel.Font.Color := $00B0B0B0;
  WizardForm.FilenameLabel.Font.Color := $00808080;
  WizardForm.FinishedLabel.Font.Color := $00E0E0E0;

  // Finished-page post-install checkboxes ("Launch ZestSSH", "See what's
  // new") - this checklist renders with the OS default (dark) text, which
  // is unreadable on the dark surface. Force a light label colour + dark bg.
  WizardForm.RunList.Color := $00111111;
  WizardForm.RunList.Font.Color := $00E0E0E0;

  // License page. A RichEdit memo does NOT honour Font.Color for plain-text
  // content, so forcing it dark left the license unreadable - keep it a light
  // box with dark text (readable, and what every installer does). The page's
  // OTHER text - the "you must accept" intro line and the accept / decline
  // radios - are not exposed as named WizardForm controls, so walk the page's
  // child controls and recolour every static label + radio to light. Radios
  // need ParentFont := False first, or Windows keeps the inherited dark font.
  WizardForm.LicenseMemo.Color := $00FFFFFF;
  WizardForm.LicenseMemo.Font.Color := $00101010;
  // Recolour the page's static intro label(s) to light (static text honours
  // Font.Color; the radio captions do NOT, so they get overlay labels below).
  LicensePanel := WizardForm.LicenseAcceptedRadio.Parent;
  for I := 0 to LicensePanel.ControlCount - 1 do
    if LicensePanel.Controls[I] is TNewStaticText then
      TNewStaticText(LicensePanel.Controls[I]).Font.Color := $00E0E0E0;
  AcceptLbl := LightRadioLabel(WizardForm.LicenseAcceptedRadio);
  AcceptLbl.OnClick := @LicenseAcceptClick;
  DeclineLbl := LightRadioLabel(WizardForm.LicenseNotAcceptedRadio);
  DeclineLbl.OnClick := @LicenseDeclineClick;

  // Preparing page message (static label, honours Font.Color). Its radios are
  // only reached when a running copy locks a file, which the "close ZestSSH
  // first" guidance avoids, so they are left at default here.
  WizardForm.PreparingLabel.Font.Color := $00E0E0E0;

  // The page-name header clipped descenders (the 'y' in "Ready") at Size
  // 12 bold. Give the label a few px more height and nudge the description
  // down so descenders render fully on EVERY page, at 100% and 150% scaling.
  WizardForm.PageNameLabel.Height := WizardForm.PageNameLabel.Height + ScaleY(6);
  WizardForm.PageDescriptionLabel.Top := WizardForm.PageDescriptionLabel.Top + ScaleY(6);

  // A slim orange accent rail down the left of the interior pages, echoing
  // the Welcome/Finished sidebar so the flow reads as one designed sequence
  // rather than two styles.
  AccentRail := TPanel.Create(WizardForm);
  AccentRail.Parent := WizardForm.InnerPage;
  AccentRail.Left := 0;
  AccentRail.Top := 0;
  AccentRail.Width := ScaleX(4);
  AccentRail.Height := WizardForm.InnerPage.Height;
  AccentRail.Anchors := [akLeft, akTop, akBottom];
  AccentRail.BevelOuter := bvNone;
  AccentRail.ParentBackground := False;
  AccentRail.Color := $000A60E8; // orange (#E8600A) in BGR

  // The tasks list held 4 items but filled the page, leaving a large empty
  // region that reads as "something failed to load". Size it to its content
  // and use the freed space to explain the non-obvious options.
  WizardForm.TasksList.Height := ScaleY(160);
  TasksHint := TNewStaticText.Create(WizardForm);
  TasksHint.Parent := WizardForm.SelectTasksPage;
  TasksHint.Left := WizardForm.TasksList.Left;
  TasksHint.Top := WizardForm.TasksList.Top + WizardForm.TasksList.Height + ScaleY(14);
  TasksHint.Width := WizardForm.TasksList.Width;
  TasksHint.AutoSize := False;
  TasksHint.WordWrap := True;
  TasksHint.Height := ScaleY(110);
  TasksHint.Font.Color := $00B0B0B0;
  TasksHint.Caption :=
    'PATH lets you launch ZestSSH by typing "zestssh" in any terminal.' + #13#10 +
    'Startup opens ZestSSH automatically when you sign in to Windows.' + #13#10 + #13#10 +
    'Both are optional and left off by default.';
end;

// I10: match the uninstaller's appearance to the installer - it otherwise
// falls back to Inno's default light theme.
procedure InitializeUninstallProgressForm();
begin
  UninstallProgressForm.Color := $000A0A0A;
  UninstallProgressForm.MainPanel.Color := $00111111;
  UninstallProgressForm.Bevel.Visible := False;
  UninstallProgressForm.PageNameLabel.Font.Color := $000A60E8;
  UninstallProgressForm.PageNameLabel.Font.Style := [fsBold];
  UninstallProgressForm.PageDescriptionLabel.Font.Color := $00B0B0B0;
  UninstallProgressForm.StatusLabel.Font.Color := $00B0B0B0;
end;
